{
  "$schema": "schemas/frame-contract.schema.json",
  "version": "1.1.0",
  "status": "active",
  "canonical_viewport": {
    "width": 390,
    "height": 844
  },
  "regions": [
    {
      "id": "phone-shell",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "viewport",
      "intersection_group": "shell"
    },
    {
      "id": "header",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "phone-shell",
      "intersection_group": "fixed-ui"
    },
    {
      "id": "chat",
      "scroll_axis": "vertical",
      "overflow_allowed": true,
      "clipping_owner": "phone-shell",
      "return_anchor": "presentation-ready-card",
      "intersection_group": "content"
    },
    {
      "id": "notifications-list",
      "scroll_axis": "vertical",
      "overflow_allowed": true,
      "clipping_owner": "phone-shell",
      "return_anchor": "notification-item",
      "intersection_group": "content"
    },
    {
      "id": "composer",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "phone-shell",
      "intersection_group": "fixed-ui"
    },
    {
      "id": "time-lapse-overlay",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "phone-shell",
      "intersection_group": "overlay"
    },
    {
      "id": "viewer-surface",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "phone-shell",
      "intersection_group": "viewer"
    },
    {
      "id": "viewer-toolbar",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "viewer-surface",
      "intersection_group": "fixed-ui"
    },
    {
      "id": "viewer-stage",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "viewer-surface",
      "intersection_group": "content"
    },
    {
      "id": "viewer-actions",
      "scroll_axis": "none",
      "overflow_allowed": false,
      "clipping_owner": "viewer-surface",
      "intersection_group": "fixed-ui"
    }
  ],
  "allowed_overlaps": [
    {
      "id": "notification-dot-on-bell",
      "source_component": "notification-dot",
      "target_component": "notification-bell",
      "maximum_overlap_square_px": 196
    }
  ],
  "frames": [
    {
      "state_id": "lisa-materials-ready",
      "region_id": "chat",
      "action_ids": [
        "edit-materials",
        "email-materials",
        "order-presentation"
      ]
    },
    {
      "state_id": "lisa-materials-email-sent",
      "region_id": "chat",
      "action_ids": [
        "order-presentation"
      ]
    },
    {
      "state_id": "lisa-presentation-order-submitting",
      "region_id": "chat",
      "action_ids": []
    },
    {
      "state_id": "lisa-presentation-order-failed",
      "region_id": "chat",
      "action_ids": [
        "retry-order",
        "return-to-materials"
      ]
    },
    {
      "state_id": "lisa-presentation-generating",
      "region_id": "chat",
      "action_ids": []
    },
    {
      "state_id": "lisa-presentation-ready-unread",
      "region_id": "chat",
      "action_ids": [
        "open-result-from-chat"
      ]
    },
    {
