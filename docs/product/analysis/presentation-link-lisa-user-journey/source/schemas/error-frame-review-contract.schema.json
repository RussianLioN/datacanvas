{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-frame-review-contract.schema.json",
  "title": "Договор изолированных черновых кадров ошибок CO-2026-003",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "change_order_id", "status", "base_frame_id", "visual_template_frame_id", "mock_phone_status_time_value", "transition_rendering_mode", "active_release_mutation_prohibited", "full_delivery_is_represented_by", "candidates"],
  "properties": {
    "$schema": {"const": "schemas/error-frame-review-contract.schema.json"},
    "version": {"const": "1.0.0"},
    "change_order_id": {"const": "CO-2026-003"},
    "status": {"const": "draft_png_rendered_pending_owner_approval"},
    "base_frame_id": {"const": "lisa-presentation-generating"},
    "visual_template_frame_id": {"const": "lisa-presentation-sent"},
    "mock_phone_status_time_value": {"const": "13:40"},
    "transition_rendering_mode": {"const": "same_screen_dynamic_state"},
    "active_release_mutation_prohibited": {"const": true},
    "full_delivery_is_represented_by": {"const": "lisa-delivery-partial"},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame_id", "directory", "message_id", "keeps_generation_message", "text", "display_lines", "baselines", "safe_area"],
        "properties": {
          "frame_id": {"enum": ["lisa-order-not-accepted", "lisa-delivery-delayed", "lisa-delivery-partial"]},
          "directory": {"type": "string", "pattern": "^lisa-(order-not-accepted|delivery-delayed|delivery-partial)-clock-13-40$"},
          "message_id": {"enum": ["order_not_accepted", "delivery_delayed", "delivery_partial"]},
          "keeps_generation_message": {"type": "boolean"},
          "text": {"type": "string", "minLength": 1},
          "display_lines": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
          "baselines": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "number"}},
          "safe_area": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}}
          }
        }
      }
    }
  }
}
