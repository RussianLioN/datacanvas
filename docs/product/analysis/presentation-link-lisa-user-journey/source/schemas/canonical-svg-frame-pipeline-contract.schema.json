{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-svg-frame-pipeline-contract.schema.json",
  "title": "Неактивный договор SVG-first кадров CO-2026-003",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "change_order_id",
    "status",
    "active",
    "generator_input",
    "render_allowed",
    "archive_allowed",
    "prototype_revision_candidate",
    "active_contract_registry_policy",
    "future_frame_ids",
    "historical_reference_frame_ids",
    "scenario_edges",
    "stakeholder_gallery_order",
    "message_topics",
    "text_selection_source",
    "presentation_pdf_donor_register",
    "presentation_variant_pdf_import",
    "client_reference_svg_update",
    "external_sources",
    "frame_svg_sources",
    "frame_review_session",
    "acceptance",
    "forbidden_methods",
    "release_boundary"
  ],
  "properties": {
    "$schema": { "const": "schemas/canonical-svg-frame-pipeline-contract.schema.json" },
    "version": { "const": "4.2.0" },
    "change_order_id": { "const": "CO-2026-003" },
    "status": { "const": "inactive_presentation_batch_drafts_pending_owner_approval" },
    "active": { "const": false },
    "generator_input": { "const": false },
    "render_allowed": { "const": false },
    "archive_allowed": { "const": false },
    "prototype_revision_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_version", "candidate_is_not_generator_input"],
      "properties": {
        "path": { "const": "source/prototype-revision-candidate.json" },
        "expected_version": { "const": "1.0.0" },
        "candidate_is_not_generator_input": { "const": true }
      }
    },
    "active_contract_registry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "listed_in_active_contracts", "inactive_contracts_are_not_generator_inputs"],
      "properties": {
        "registry_path": { "const": "source/active-contracts.json" },
        "listed_in_active_contracts": { "const": false },
        "inactive_contracts_are_not_generator_inputs": { "const": true }
      }
    },
    "future_frame_ids": { "$ref": "#/$defs/future_frame_ids" },
    "historical_reference_frame_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/state_id" },
      "uniqueItems": true
    },
    "scenario_edges": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/scenario_edge" }
    },
    "stakeholder_gallery_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "is_user_scenario_transition", "ordered_state_ids"],
      "properties": {
        "graph_id": { "const": "stakeholder_gallery_order" },
        "is_user_scenario_transition": { "const": false },
        "ordered_state_ids": { "$ref": "#/$defs/future_frame_ids" }
      }
    },
    "message_topics": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/message_topic" }
    },
    "text_selection_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required_topic_count", "render_blocked_until_all_selected"],
      "properties": {
        "path": { "const": "source/owner-approved-texts.json" },
        "required_topic_count": { "const": 5 },
        "render_blocked_until_all_selected": { "const": true }
      }
    },
    "presentation_pdf_donor_register": { "$ref": "#/$defs/presentation_pdf_donor_register" },
    "presentation_variant_pdf_import": { "$ref": "#/$defs/presentation_variant_pdf_import" },
    "client_reference_svg_update": { "$ref": "#/$defs/client_reference_svg_update" },
    "external_sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/external_source" }
    },
    "frame_svg_sources": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/frame_svg_source" }
    },
    "frame_review_session": { "$ref": "#/$defs/frame_review_session" },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_flow", "prototype_flow", "per_frame_review"],
      "properties": {
        "frame_flow": { "$ref": "#/$defs/acceptance_steps" },
        "prototype_flow": { "$ref": "#/$defs/acceptance_steps" },
        "per_frame_review": { "$ref": "#/$defs/per_frame_review" }
      }
    },
    "forbidden_methods": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_evidence_status",
        "active_release_switch_status",
        "rollback_mode",
        "future_transaction_targets"
      ],
      "properties": {
        "candidate_evidence_status": { "const": "pending" },
        "active_release_switch_status": { "const": "blocked" },
        "rollback_mode": { "const": "full_bundle_only" },
        "future_transaction_targets": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "state_id": { "type": "string", "pattern": "^lisa-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "state_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state_id" },
      "uniqueItems": true
    },
    "future_frame_ids": {
      "const": [
        "lisa-materials-full-reference",
        "lisa-presentation-generating",
        "lisa-presentation-chat-list",
        "lisa-presentation-sent",
        "lisa-presentation-email",
        "lisa-presentation-slidedoc",
        "lisa-presentation-sber2025",
        "lisa-presentation-mag",
        "lisa-order-not-accepted",
        "lisa-delivery-delayed",
        "lisa-delivery-partial"
      ]
    },
    "scenario_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "event", "to"],
      "properties": {
        "type": { "enum": ["lifecycle", "inspection"] },
        "from": {
          "anyOf": [
            { "$ref": "#/$defs/state_id" },
            { "const": "validating" }
          ]
        },
        "event": { "type": "string", "minLength": 1 },
        "to": {
          "anyOf": [
            { "$ref": "#/$defs/state_id" },
            { "const": "validating" }
          ]
        }
      }
    },
    "message_topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id", "status", "render_blocker"],
      "properties": {
        "topic_id": {
          "enum": ["button_label", "generation_started_message", "delivery_success_message", "email_subject", "email_body"]
        },
        "status": { "const": "owner_approved" },
        "render_blocker": { "const": true }
      }
    },
    "external_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "required_for_frame_id",
        "required_format",
        "canonical_svg_required_before_render",
        "status"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "required_for_frame_id": { "$ref": "#/$defs/state_id" },
        "required_format": { "enum": ["owner_supplied_pdf_visual_donor", "canonical_svg_source", "owner_supplied_email_visual_reference"] },
        "canonical_svg_required_before_render": { "type": "boolean" },
        "status": { "enum": ["owner_attachment_received_pending_pdf_draft_review", "pending_owner_attachment", "repository_svg_candidate_approved_from_owner_visual_reference"] }
      }
    },
    "frame_svg_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "svg_editing_mode",
        "canonical_svg_status",
        "approved_text_status",
        "svg_visual_check_status",
        "draft_png_status",
        "owner_frame_approval_status"
      ],
      "properties": {
        "frame_id": { "$ref": "#/$defs/state_id" },
        "svg_editing_mode": {
          "enum": [
            "canonical_svg_existing_groups_only",
            "new_canonical_svg_composition_from_pdf_visual_reference",
            "approved_pdf_to_png"
          ]
        },
        "canonical_svg_status": { "type": "string" },
        "approved_text_status": { "type": "string" },
        "svg_visual_check_status": { "type": "string" },
        "draft_png_status": { "type": "string" },
        "owner_frame_approval_status": { "enum": ["pending", "approved", "not_required"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "frame_id": { "const": "lisa-materials-full-reference" }
            }
          },
          "then": {
            "properties": {
              "canonical_svg_status": { "const": "prepared_existing_group_content_replaced" },
              "approved_text_status": { "const": "owner_approved" },
              "svg_visual_check_status": { "const": "passed" },
              "draft_png_status": { "const": "rendered_current_resolution" },
              "owner_frame_approval_status": { "const": "approved" }
            }
          },
          "else": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "frame_id": { "const": "lisa-presentation-generating" }
                  }
                },
                "then": {
                  "properties": {
                    "canonical_svg_status": { "const": "prepared_existing_group_content_replaced" },
                    "approved_text_status": { "const": "owner_approved" },
                    "svg_visual_check_status": { "const": "passed" },
                    "draft_png_status": { "const": "rendered_current_resolution" },
                    "owner_frame_approval_status": { "const": "approved" }
                  }
                },
                "else": {
                  "allOf": [
                    {
                      "if": { "properties": { "frame_id": { "const": "lisa-presentation-chat-list" } } },
                      "then": {
                        "properties": {
                          "canonical_svg_status": { "const": "preserved_without_rework" },
                          "approved_text_status": { "const": "not_applicable" },
                          "svg_visual_check_status": { "const": "not_required" },
                          "draft_png_status": { "const": "existing_frame_preserved" },
                          "owner_frame_approval_status": { "const": "not_required" }
                        }
                      },
                      "else": {
                        "allOf": [
                          {
                            "if": { "properties": { "frame_id": { "const": "lisa-presentation-sent" } } },
                            "then": {
                              "properties": {
                                "canonical_svg_status": { "const": "prepared_existing_group_content_replaced" },
                                "approved_text_status": { "const": "owner_approved" },
                                "svg_visual_check_status": { "const": "passed" },
                                "draft_png_status": { "const": "rendered_current_resolution" },
                                "owner_frame_approval_status": { "const": "approved" }
                              }
                            },
                            "else": {
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "frame_id": { "enum": ["lisa-presentation-slidedoc", "lisa-presentation-sber2025", "lisa-presentation-mag"] }
                                    }
                                  },
                                  "then": {
                                    "properties": {
                                      "canonical_svg_status": { "const": "not_applicable" },
                                      "approved_text_status": { "const": "not_applicable" },
                                      "svg_visual_check_status": { "const": "not_applicable" },
                                      "draft_png_status": { "const": "rendered_current_resolution" },
                                      "owner_frame_approval_status": { "const": "pending" }
                                    }
                                  },
                                  "else": {
                                    "allOf": [
                                      {
                                        "if": {
                                          "properties": {
                                            "frame_id": { "enum": ["lisa-presentation-email", "lisa-order-not-accepted", "lisa-delivery-delayed", "lisa-delivery-partial"] }
                                          }
                                        },
                                        "then": {
                                          "properties": {
                                            "canonical_svg_status": { "enum": ["prepared_existing_group_content_replaced", "prepared_visual_reference_composition"] },
                                            "approved_text_status": { "enum": ["authoritative_interview_agreed", "owner_approved"] },
                                            "svg_visual_check_status": { "const": "passed" },
                                            "draft_png_status": { "const": "rendered_current_resolution" },
                                            "owner_frame_approval_status": { "const": "approved" }
                                          }
                                        },
                                        "else": {
                                          "properties": {
                                            "canonical_svg_status": { "const": "pending_source" },
                                            "approved_text_status": { "const": "pending" },
                                            "svg_visual_check_status": { "const": "pending" },
                                            "draft_png_status": { "const": "blocked" },
                                            "owner_frame_approval_status": { "const": "pending" }
                                          }
                                        }
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "frame_review_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_frame_id",
        "next_frame_id",
        "source_pdf_file_name",
        "draft_png_path",
        "review_manifest_path",
        "base_frame_id",
        "base_svg_path",
        "base_owner_approval_path",
        "transition_rendering_mode",
        "dynamic_footer",
        "edit_mode",
        "prohibited_legacy_overlay_ids",
        "active_release_mutation_prohibited",
        "owner_approval_record_path",
        "batch_draft_preparation_authorized_by_owner",
        "next_frame_blocked_until_owner_approval",
        "draft_prototype_path",
        "skipped_frame_id",
        "skipped_frame_reason",
        "error_review_batch"
      ],
      "properties": {
        "status": { "enum": ["presentation_variant_frames_blocked_pending_canonical_svg_sources", "presentation_variant_frame_pending_owner_approval", "presentation_variant_batch_drafts_pending_owner_approval"] },
        "current_frame_id": { "enum": ["lisa-presentation-email", "lisa-presentation-slidedoc"] },
        "next_frame_id": { "enum": ["lisa-presentation-slidedoc", "lisa-presentation-sber2025"] },
        "source_pdf_file_name": { "const": "vodoley_dense_slidedoc.pdf" },
        "draft_png_path": { "const": "candidate-evidence/frame-review/lisa-presentation-slidedoc-pdf-import/draft-current-resolution.png" },
        "review_manifest_path": { "const": "candidate-evidence/frame-review/lisa-presentation-slidedoc-pdf-import/review-source-manifest.json" },
        "base_frame_id": { "enum": ["lisa-presentation-sent", "lisa-presentation-email"] },
        "base_svg_path": { "enum": ["candidate-evidence/frame-review/lisa-presentation-sent/source.svg", "candidate-evidence/frame-review/lisa-presentation-email/source.svg"] },
        "base_owner_approval_path": { "enum": ["candidate-evidence/frame-review/lisa-presentation-sent/owner-approval.json", "candidate-evidence/frame-review/lisa-presentation-email/owner-approval.json"] },
        "transition_rendering_mode": { "const": "separate_desktop_frame" },
        "dynamic_footer": { "type": "null" },
        "edit_mode": { "const": "approved_pdf_to_png" },
        "prohibited_legacy_overlay_ids": { "const": ["html_overlay", "css_overlay", "png_text_overlay"] },
        "active_release_mutation_prohibited": { "const": true },
        "owner_approval_record_path": { "enum": ["candidate-evidence/frame-review/lisa-presentation-email/owner-approval.json", null] },
        "batch_draft_preparation_authorized_by_owner": { "const": true },
        "next_frame_blocked_until_owner_approval": { "const": false },
        "draft_prototype_path": { "const": "candidate-evidence/prototype-draft/index.html" },
        "skipped_frame_id": { "const": "lisa-presentation-chat-list" },
        "skipped_frame_reason": { "const": "owner_direction_no_rework" },
        "error_review_batch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_path", "candidate_frame_ids", "acceptance_mode", "full_delivery_representation_frame_id", "draft_preparation_authorized_by_owner"],
          "properties": {
            "contract_path": { "const": "source/error-frame-review-contract.json" },
            "candidate_frame_ids": { "const": ["lisa-order-not-accepted", "lisa-delivery-delayed", "lisa-delivery-partial"] },
            "acceptance_mode": { "const": "all_frames_approved" },
            "full_delivery_representation_frame_id": { "const": "lisa-delivery-partial" },
            "draft_preparation_authorized_by_owner": { "const": true }
          }
        }
      }
    },
    "acceptance_steps": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "presentation_pdf_donor_register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "import_mode", "source_svg_required", "raw_pdf_served_by_demo"],
      "properties": {
        "path": { "const": "source/presentation-pdf-raster-import-contract.json" },
        "import_mode": { "const": "approved_pdf_to_png" },
        "source_svg_required": { "const": false },
        "raw_pdf_served_by_demo": { "const": false }
      }
    },
    "presentation_variant_pdf_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_path", "import_mode", "source_svg_required", "draft_scale", "final_scale", "active_release_mutation_prohibited"],
      "properties": {
        "contract_path": { "const": "source/presentation-pdf-raster-import-contract.json" },
        "import_mode": { "const": "approved_pdf_to_png" },
        "source_svg_required": { "const": false },
        "draft_scale": { "const": 1 },
        "final_scale": { "const": 4 },
        "active_release_mutation_prohibited": { "const": true }
      }
    },
    "client_reference_svg_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_data_path",
        "historical_client_marker",
        "replacement_client_name",
        "full_reference_frame_id",
        "source_group_ids_preserved",
        "visible_group_ids",
        "excluded_group_ids",
        "exclusion_scope",
        "source_data_mutation_allowed",
        "cta_geometry",
        "continuation_frame_ids",
        "svg_editing_mode",
        "status"
      ],
      "properties": {
        "source_data_path": { "const": "source/client-reference-data.json" },
        "historical_client_marker": { "const": "ГК Достовалова" },
        "replacement_client_name": { "const": "ООО «Водолей Трейд»" },
        "full_reference_frame_id": { "const": "lisa-materials-full-reference" },
        "source_group_ids_preserved": {
          "const": [
            "general_information",
            "business_owners",
            "financial_indicators",
            "cooperation",
            "sber_share",
            "active_deals",
            "potential",
            "preapproved_offers",
            "insights",
            "meeting_agreements",
            "dynamic_suggestions",
            "actions"
          ]
        },
        "visible_group_ids": {
          "const": [
            "general_information",
            "business_owners",
            "financial_indicators",
            "cooperation",
            "sber_share",
            "active_deals",
            "potential",
            "preapproved_offers",
            "insights",
            "meeting_agreements"
          ]
        },
        "excluded_group_ids": { "const": ["dynamic_suggestions", "actions"] },
        "exclusion_scope": { "const": "visual_frame_only" },
        "source_data_mutation_allowed": { "const": false },
        "cta_geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["button_rect", "font_size", "center_tolerance_px", "measurement_method"],
          "properties": {
            "button_rect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "const": 80 },
                "y": { "const": 4968 },
                "width": { "const": 361 },
                "height": { "const": 40 }
              }
            },
            "font_size": { "const": 16 },
            "center_tolerance_px": { "const": 0.5 },
            "measurement_method": { "const": "pinned_font_path_bounding_box" }
          }
        },
        "continuation_frame_ids": {
          "const": [
            "lisa-presentation-generating",
            "lisa-presentation-chat-list",
            "lisa-presentation-sent",
            "lisa-order-not-accepted",
            "lisa-delivery-delayed",
            "lisa-delivery-partial"
          ]
        },
        "svg_editing_mode": { "const": "canonical_svg_existing_groups_only" },
        "status": { "const": "pending_frame_cycle" }
      }
    },
    "per_frame_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "review_surface",
        "draft_prototype_rendering_mode",
        "runtime_shell_parity_required",
        "runtime_shell_source_path",
        "allowed_runtime_differences",
        "allowed_changed_frame_count",
        "candidate_must_replace_same_frame_id",
        "draft_prototype_all_future_frames_authorized",
        "next_frame_blocked_until_owner_approval",
        "active_release_mutation_prohibited"
      ],
      "properties": {
        "required": { "const": true },
        "review_surface": { "const": "isolated_current_prototype_copy" },
        "draft_prototype_rendering_mode": { "const": "isolated_current_prototype_copy_with_frame_asset_substitution" },
        "runtime_shell_parity_required": { "const": true },
        "runtime_shell_source_path": { "const": "demo" },
        "allowed_runtime_differences": {
          "const": ["data.js", "assets/**"]
        },
        "allowed_changed_frame_count": { "const": 11 },
        "candidate_must_replace_same_frame_id": { "const": true },
        "draft_prototype_all_future_frames_authorized": { "const": true },
        "next_frame_blocked_until_owner_approval": { "const": false },
        "active_release_mutation_prohibited": { "const": true }
      }
    }
  }
}
