{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prototype-package-contract.schema.json",
  "title": "Договор минимального автономного пакета десятиэкранного маршрута Лисы",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runtime_root",
    "asset_root",
    "archive_path",
    "archive_members",
    "prohibitions",
    "commands"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/prototype-package-contract.schema.json"
    },
    "version": {
      "const": "3.0.0"
    },
    "runtime_root": {
      "const": "demo"
    },
    "asset_root": {
      "const": "demo/assets"
    },
    "archive_path": {
      "const": "derived/lisa-presentation-user-journey-demo.zip"
    },
    "archive_members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:README\\.md|manifest\\.json|index\\.html|app\\.js|data\\.js|styles\\.css|assets/[a-z0-9]+(?:-[a-z0-9]+)*\\.png)$"
      }
    },
    "prohibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_runtime_dependency",
        "parent_directory_references",
        "network_requests",
        "absolute_local_paths",
        "raw_svg_in_archive",
        "generated_outputs_as_contract_inputs",
        "old_twenty_state_route_active"
      ],
      "properties": {
        "source_runtime_dependency": {
          "const": false
        },
        "parent_directory_references": {
          "const": false
        },
        "network_requests": {
          "const": false
        },
        "absolute_local_paths": {
          "const": false
        },
        "raw_svg_in_archive": {
          "const": false
        },
        "generated_outputs_as_contract_inputs": {
          "const": false
        },
        "old_twenty_state_route_active": {
          "const": false
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate",
        "validate",
        "check"
      ],
      "properties": {
        "generate": {
          "type": "string",
          "minLength": 1
        },
        "validate": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
