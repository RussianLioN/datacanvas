{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presentation-preview-contract.schema.json",
  "title": "Контракт предпросмотра презентации в Лисе",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "audience",
    "communication_job",
    "aspect_ratio",
    "slides"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/presentation-preview-contract.schema.json"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "owner-review-pending",
        "owner-approved-prototype"
      ]
    },
    "audience": {
      "const": "internal-client-manager-and-leader"
    },
    "communication_job": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "const": "16:9"
    },
    "slides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "short_title",
          "layout",
          "data_bindings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "short_title": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "enum": [
              "hero-metrics",
              "offers-and-comparison",
              "decision-path"
            ]
          },
          "data_bindings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sections\\.[a-z0-9-]+\\.blocks\\.[a-z0-9-]+\\.items\\.[a-z0-9-]+(?:\\.[a-z0-9_-]+)?$"
            }
          },
          "card_summaries": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "binding",
                "text"
              ],
              "properties": {
                "binding": {
                  "type": "string",
                  "pattern": "^sections\\.[a-z0-9-]+\\.blocks\\.[a-z0-9-]+\\.items\\.[a-z0-9-]+(?:\\.[a-z0-9_-]+)?$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            }
          }
        }
      }
    }
  }
}
