{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lisa-presentation-variant-content-map.schema.json",
  "title": "Карта разрешённого содержания варианта презентации Лисы",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "change_order_id", "frame_id", "status", "visual_donor_id", "visual_reference_only", "raw_pdf_direct_render_prohibited", "content_source", "forbidden_donor_content", "allowed_model_fact_exception", "readability_policy", "pages", "initial_svg_creation_rule", "active_release_mutation_prohibited"],
  "properties": {
    "$schema": { "const": "schemas/lisa-presentation-variant-content-map.schema.json" },
    "version": { "const": "1.0.0" },
    "change_order_id": { "const": "CO-2026-003" },
    "frame_id": { "const": "lisa-presentation-slidedoc" },
    "status": { "const": "prepared_for_initial_canonical_svg_composition" },
    "visual_donor_id": { "const": "presentation_variant_slidedoc_pdf_donor" },
    "visual_reference_only": { "const": true },
    "raw_pdf_direct_render_prohibited": { "const": true },
    "content_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "data_mutation_allowed"],
      "properties": {
        "path": { "const": "source/client-reference-data.json" },
        "status": { "const": "approved_for_demo_model" },
        "data_mutation_allowed": { "const": false }
      }
    },
    "forbidden_donor_content": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "allowed_model_fact_exception": { "const": "Доставалова Ирина Антоновна" },
    "readability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_page_dimensions", "minimum_body_font_size_px", "minimum_table_font_size_px", "minimum_card_heading_font_size_px", "minimum_line_height_px", "all_model_facts_must_remain_visible", "individual_page_pngs_required_for_owner_review"],
      "properties": {
        "draft_page_dimensions": { "const": { "width": 960, "height": 540 } },
        "minimum_body_font_size_px": { "const": 10 },
        "minimum_table_font_size_px": { "const": 10 },
        "minimum_card_heading_font_size_px": { "const": 14 },
        "minimum_line_height_px": { "const": 12 },
        "all_model_facts_must_remain_visible": { "const": true },
        "individual_page_pngs_required_for_owner_review": { "const": true }
      }
    },
    "pages": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/page" } },
    "initial_svg_creation_rule": { "const": "new_vector_composition_from_visual_tokens_then_existing_groups_only" },
    "active_release_mutation_prohibited": { "const": true }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "covered_group_ids", "content_bindings"],
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 3 },
        "covered_group_ids": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "content_bindings": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/binding" } }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["svg_group_id", "group_id", "data_path", "fact_indexes"],
      "properties": {
        "svg_group_id": { "type": "string", "pattern": "^slidedoc-page-[1-3]-[a-z0-9-]+$" },
        "group_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "data_path": { "type": "string", "pattern": "^/data_groups/[0-9]+$" },
        "fact_indexes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true }
      }
    }
  }
}
