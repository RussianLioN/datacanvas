{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lisa-presentation-email-review-source-manifest.schema.json",
  "title": "Манифест SVG-первичного чернового кадра письма CO-2026-003",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "frame_id", "status", "visual_reference_id", "visual_reference_persisted_in_repository", "source_svg_path", "source_svg_sha256", "approved_texts_path", "approved_texts_sha256", "recipient", "signature_lines", "subject", "body", "attachments", "mock_email_time_value", "active_release_mutation_prohibited", "draft_png_rendered", "draft_png_path", "draft_png_sha256", "draft_png_dimensions", "owner_frame_approval", "draft_png_non_white_pixel_count"],
  "properties": {
    "$schema": {"const": "../../../source/schemas/lisa-presentation-email-review-source-manifest.schema.json"},
    "version": {"const": "1.0.0"},
    "frame_id": {"const": "lisa-presentation-email"},
    "status": {"enum": ["svg_source_prepared_pending_visual_check", "draft_png_rendered_pending_owner_approval", "owner_frame_approved"]},
    "visual_reference_id": {"const": "owner_supplied_outlook_corporate_email_screenshot_2026_08_19"},
    "visual_reference_persisted_in_repository": {"const": false},
    "source_svg_path": {"const": "candidate-evidence/frame-review/lisa-presentation-email/source.svg"},
    "source_svg_sha256": {"$ref": "#/$defs/sha256"},
    "approved_texts_path": {"const": "source/owner-approved-texts.json"},
    "approved_texts_sha256": {"$ref": "#/$defs/sha256"},
    "recipient": {"const": "Солодовников Роман Юрьевич"},
    "signature_lines": {"const": ["С уважением,", "команда «ЕФС • Наш бизнес»"]},
    "subject": {"const": "Презентация по справке ООО «Водолей Трейд»"},
    "body": {"const": "Во вложении презентация по Справке по клиенту ООО «Водолей Трейд»."},
    "attachments": {"const": [{"display_name": "Презентация по справке.pptx", "format": "PPTX"}, {"display_name": "Презентация по справке.pdf", "format": "PDF"}]},
    "mock_email_time_value": {"const": "13:40"},
    "active_release_mutation_prohibited": {"const": true},
    "draft_png_rendered": {"type": "boolean"},
    "draft_png_path": {"type": ["string", "null"]},
    "draft_png_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "draft_png_dimensions": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"const": 1280}, "height": {"const": 960}}}, {"type": "null"}]},
    "draft_png_non_white_pixel_count": {"type": "integer", "minimum": 1},
    "owner_frame_approval": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["record_path", "decision", "decision_text", "decision_source", "approval_time_precision", "approved_on"], "properties": {"record_path": {"const": "candidate-evidence/frame-review/lisa-presentation-email/owner-approval.json"}, "decision": {"const": "approved"}, "decision_text": {"const": "ok"}, "decision_source": {"const": "Product Owner в рабочем чате"}, "approval_time_precision": {"const": "date_only"}, "approved_on": {"const": "2026-08-24"}}}]}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "owner_frame_approved"}}, "required": ["status"]}, "then": {"properties": {"draft_png_rendered": {"const": true}, "draft_png_path": {"const": "candidate-evidence/frame-review/lisa-presentation-email/draft-current-resolution.png"}, "owner_frame_approval": {"type": "object"}}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
