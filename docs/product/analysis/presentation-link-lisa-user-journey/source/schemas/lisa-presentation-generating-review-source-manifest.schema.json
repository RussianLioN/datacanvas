{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lisa-presentation-generating-review-source-manifest.schema.json",
  "title": "Манифест чернового динамического кадра начала формирования презентации",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "frame_id",
    "status",
    "base_frame_id",
    "base_svg_path",
    "base_svg_sha256",
    "base_owner_approval_path",
    "base_owner_approved_svg_sha256",
    "transition_rendering_mode",
    "source_svg_path",
    "source_svg_sha256",
    "approved_texts_path",
    "approved_texts_sha256",
    "button_label_text",
    "disabled_button",
    "dynamic_footer",
    "generation_started_message",
    "preserved_visible_group_ids",
    "modified_existing_group_ids",
    "prohibited_legacy_overlay_ids",
    "text_outline_font",
    "active_release_mutation_prohibited",
    "draft_png_rendered",
    "draft_png_path",
    "draft_png_sha256",
    "draft_png_dimensions",
    "draft_png_non_white_pixel_count",
    "owner_frame_approval"
  ],
  "properties": {
    "$schema": { "const": "../../../source/schemas/lisa-presentation-generating-review-source-manifest.schema.json" },
    "version": { "const": "2.2.0" },
    "frame_id": { "const": "lisa-presentation-generating" },
    "status": { "enum": ["svg_source_prepared_pending_visual_check", "draft_png_rendered_pending_owner_approval", "owner_frame_approved"] },
    "base_frame_id": { "const": "lisa-materials-full-reference" },
    "base_svg_path": { "const": "candidate-evidence/frame-review/lisa-materials-full-reference/source.svg" },
    "base_svg_sha256": { "$ref": "#/$defs/sha256" },
    "base_owner_approval_path": { "const": "candidate-evidence/frame-review/lisa-materials-full-reference/owner-approval.json" },
    "base_owner_approved_svg_sha256": { "$ref": "#/$defs/sha256" },
    "transition_rendering_mode": { "const": "same_screen_dynamic_state" },
    "source_svg_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating/source.svg" },
    "source_svg_sha256": { "$ref": "#/$defs/sha256" },
    "approved_texts_path": { "const": "source/owner-approved-texts.json" },
    "approved_texts_sha256": { "$ref": "#/$defs/sha256" },
    "button_label_text": { "const": "Создать презентацию по справке" },
    "disabled_button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing_group_id", "aria_disabled", "opacity", "label_unchanged"],
      "properties": {
        "existing_group_id": { "const": "buttons_2.0" },
        "aria_disabled": { "const": true },
        "opacity": { "const": 1 },
        "label_unchanged": { "const": true }
      }
    },
    "dynamic_footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["button_translate_y", "background_fill", "label_fill", "status_placement", "extension_height"],
      "properties": {
        "button_translate_y": { "const": -18 },
        "background_fill": { "const": "rgb(224,227,234)" },
        "label_fill": { "const": "rgb(143,148,160)" },
        "status_placement": { "const": "below_disabled_button" },
        "extension_height": { "const": 82 }
      }
    },
    "generation_started_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "display_lines", "time_value", "inserted_into_existing_frame_group_id", "font_size", "fill", "baselines", "safe_area", "line_widths"],
      "properties": {
        "text": { "const": "Формирование презентации началось в ЧЧ:ММ и займет не более 20 минут. После завершения презентация будет направлена по электронной почте в SIGMA и OMEGA." },
        "display_lines": {
          "const": [
            "Формирование презентации началось в 13:24",
            "и займет не более 20 минут.",
            "После завершения презентация будет направлена",
            "по электронной почте в SIGMA и OMEGA."
          ]
        },
        "time_value": { "const": "13:24" },
        "inserted_into_existing_frame_group_id": { "const": "button_footer_2.0" },
        "font_size": { "const": 11.5 },
        "fill": { "const": "rgb(73,80,94)" },
        "baselines": { "const": [2970, 2986, 3002, 3018] },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "const": 80 },
            "y": { "const": 2958 },
            "width": { "const": 345 },
            "height": { "const": 64 }
          }
        },
        "line_widths": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 345 }
        }
      }
    },
    "preserved_visible_group_ids": {
      "const": [
        "general_information",
        "business_owners",
        "financial_indicators",
        "cooperation",
        "sber_share",
        "active_deals",
        "potential",
        "preapproved_offers",
        "insights",
        "meeting_agreements"
      ]
    },
    "modified_existing_group_ids": { "const": ["Group 2131328969", "button_footer_2.0", "buttons_2.0", "logo", "Home indicator"] },
    "prohibited_legacy_overlay_ids": { "const": ["lisa-edit-5-4-title", "lisa-status-"] },
    "text_outline_font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "sha256", "copied_to_git"],
      "properties": {
        "family": { "const": "SB Sans Display" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "copied_to_git": { "const": false }
      }
    },
    "active_release_mutation_prohibited": { "const": true },
    "draft_png_rendered": { "type": "boolean" },
    "draft_png_path": { "anyOf": [{ "type": "null" }, { "const": "candidate-evidence/frame-review/lisa-presentation-generating/draft-current-resolution.png" }] },
    "draft_png_sha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "draft_png_dimensions": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "const": 521 }, "height": { "const": 3226 } }
        }
      ]
    },
    "draft_png_non_white_pixel_count": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1000 }] },
    "owner_frame_approval": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_path", "decision", "decision_text", "decision_source", "approved_at"],
          "properties": {
            "record_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating/owner-approval.json" },
            "decision": { "const": "approved" },
            "decision_text": { "const": "кадр принят" },
            "decision_source": { "const": "Product Owner в рабочем чате" },
            "approved_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "svg_source_prepared_pending_visual_check" } }, "required": ["status"] },
      "then": {
        "properties": {
          "draft_png_rendered": { "const": false },
          "draft_png_path": { "type": "null" },
          "draft_png_sha256": { "type": "null" },
          "draft_png_dimensions": { "type": "null" },
          "draft_png_non_white_pixel_count": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "draft_png_rendered": { "const": true },
          "draft_png_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating/draft-current-resolution.png" },
          "draft_png_sha256": { "$ref": "#/$defs/sha256" },
          "draft_png_dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": { "width": { "const": 521 }, "height": { "const": 3226 } }
          },
          "draft_png_non_white_pixel_count": { "type": "integer", "minimum": 1000 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "owner_frame_approved" } }, "required": ["status"] },
      "then": { "properties": { "owner_frame_approval": { "type": "object" } } },
      "else": { "properties": { "owner_frame_approval": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
