{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presentation-pdf-donor-register.schema.json",
  "title": "Реестр PDF-доноров будущих кадров презентации CO-2026-003",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "change_order_id",
    "status",
    "inputs_committed_to_git",
    "raw_pdf_direct_render_prohibited",
    "existing_historical_pdf_importer_not_invoked",
    "canonical_svg_required_before_draft_render",
    "donors"
  ],
  "properties": {
    "$schema": { "const": "schemas/presentation-pdf-donor-register.schema.json" },
    "version": { "const": "1.0.0" },
    "change_order_id": { "const": "CO-2026-003" },
    "status": { "const": "owner_attachments_received_pending_canonical_svg_intake" },
    "inputs_committed_to_git": { "const": false },
    "raw_pdf_direct_render_prohibited": { "const": true },
    "existing_historical_pdf_importer_not_invoked": { "const": true },
    "canonical_svg_required_before_draft_render": { "const": true },
    "donors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/donor" }
    }
  },
  "$defs": {
    "donor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["donor_id", "frame_id", "source_file_name", "sha256", "page_count", "use", "status"],
      "properties": {
        "donor_id": {
          "enum": [
            "presentation_variant_slidedoc_pdf_donor",
            "presentation_variant_sber2025_pdf_donor",
            "presentation_variant_mag_pdf_donor"
          ]
        },
        "frame_id": {
          "enum": [
            "lisa-presentation-slidedoc",
            "lisa-presentation-sber2025",
            "lisa-presentation-mag"
          ]
        },
        "source_file_name": { "type": "string", "pattern": "^vodoley_dense_[a-z0-9]+\\.pdf$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page_count": { "const": 3 },
        "use": { "const": "visual_reference_only" },
        "status": { "const": "owner_attachment_received_pending_canonical_svg_intake" }
      }
    }
  }
}
