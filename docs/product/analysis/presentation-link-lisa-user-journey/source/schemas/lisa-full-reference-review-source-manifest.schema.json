{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lisa-full-reference-review-source-manifest.schema.json",
  "title": "Манифест чернового кадра полной справки по клиенту",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "frame_id",
    "status",
    "base_svg_path",
    "base_svg_sha256",
    "source_svg_path",
    "source_svg_sha256",
    "client_reference_data_path",
    "client_reference_data_sha256",
    "covered_group_ids",
    "content_bottom_y",
    "frame_geometry",
    "text_outline_font",
    "edit_mode",
    "button_label_text",
    "prohibited_legacy_overlay_ids",
    "active_release_mutation_prohibited",
    "draft_png_rendered",
    "draft_png_path",
    "draft_png_sha256",
    "draft_png_dimensions",
    "draft_png_non_white_pixel_count"
  ],
  "properties": {
    "$schema": { "const": "../../../source/schemas/lisa-full-reference-review-source-manifest.schema.json" },
    "version": { "const": "1.0.0" },
    "frame_id": { "const": "lisa-materials-full-reference" },
    "status": { "const": "draft_png_rendered_pending_owner_approval" },
    "base_svg_path": { "const": "editable-sources/5.4.svg" },
    "base_svg_sha256": { "$ref": "#/$defs/sha256" },
    "source_svg_path": { "const": "candidate-evidence/frame-review/lisa-materials-full-reference/source.svg" },
    "source_svg_sha256": { "$ref": "#/$defs/sha256" },
    "client_reference_data_path": { "const": "source/client-reference-data.json" },
    "client_reference_data_sha256": { "$ref": "#/$defs/sha256" },
    "covered_group_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^[a-z_]+$" },
      "uniqueItems": true
    },
    "content_bottom_y": { "type": "number", "minimum": 1 },
    "frame_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resized", "frame_height", "footer_top_y", "canvas_height"],
      "properties": {
        "resized": { "const": true },
        "frame_height": { "type": "integer", "minimum": 1 },
        "footer_top_y": { "type": "integer", "minimum": 1 },
        "canvas_height": { "type": "integer", "minimum": 1 }
      }
    },
    "text_outline_font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "sha256", "copied_to_git"],
      "properties": {
        "family": { "const": "SB Sans Display" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "copied_to_git": { "const": false }
      }
    },
    "edit_mode": { "const": "replace_existing_frame_group_content" },
    "button_label_text": { "const": "Создать презентацию по справке" },
    "prohibited_legacy_overlay_ids": {
      "const": ["lisa-edit-5-4-title"]
    },
    "active_release_mutation_prohibited": { "const": true },
    "draft_png_rendered": { "const": true },
    "draft_png_path": { "const": "candidate-evidence/frame-review/lisa-materials-full-reference/draft-current-resolution.png" },
    "draft_png_sha256": { "$ref": "#/$defs/sha256" },
    "draft_png_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 521 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "draft_png_non_white_pixel_count": { "type": "integer", "minimum": 1000 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
