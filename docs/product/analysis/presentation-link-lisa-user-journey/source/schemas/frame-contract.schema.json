{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame-contract.schema.json",
  "title": "Контракт кадров Лисы",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "canonical_viewport",
    "regions",
    "allowed_overlaps",
    "frames"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "1.1.0"
    },
    "status": {
      "type": "string"
    },
    "canonical_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 568
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scroll_axis",
          "overflow_allowed",
          "clipping_owner",
          "intersection_group"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "scroll_axis": {
            "enum": [
              "none",
              "vertical",
              "horizontal"
            ]
          },
          "overflow_allowed": {
            "type": "boolean"
          },
          "clipping_owner": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "return_anchor": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "intersection_group": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "allowed_overlaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "region_id",
          "action_ids"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "region_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "action_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
