{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lisa-presentation-generating-clock-13-24-review-source-manifest.schema.json",
  "title": "Манифест исправляющей версии кадра начала формирования",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "frame_id", "status", "correction_scope", "correction_reason", "base_source_svg_path", "base_source_svg_sha256", "base_owner_approval_path", "mock_phone_status_time_value", "mock_phone_status_time_donor_svg_path", "source_svg_path", "source_svg_sha256", "active_release_mutation_prohibited", "draft_png_rendered", "draft_png_path", "draft_png_sha256", "draft_png_dimensions", "draft_png_non_white_pixel_count", "owner_frame_approval"],
  "properties": {
    "$schema": { "const": "../../../source/schemas/lisa-presentation-generating-clock-13-24-review-source-manifest.schema.json" },
    "version": { "const": "1.0.0" },
    "frame_id": { "const": "lisa-presentation-generating" },
    "status": { "enum": ["svg_source_prepared_pending_visual_check", "draft_png_rendered_pending_owner_approval", "owner_frame_approved"] },
    "correction_scope": { "const": "mock_phone_status_time_only" },
    "correction_reason": { "const": "системное время не может предшествовать сообщению о начале формирования" },
    "base_source_svg_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating/source.svg" },
    "base_source_svg_sha256": { "$ref": "#/$defs/sha256" },
    "base_owner_approval_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating/owner-approval.json" },
    "mock_phone_status_time_value": { "const": "13:24" },
    "mock_phone_status_time_donor_svg_path": { "const": "editable-sources/08.svg" },
    "source_svg_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating-clock-13-24/source.svg" },
    "source_svg_sha256": { "$ref": "#/$defs/sha256" },
    "active_release_mutation_prohibited": { "const": true },
    "draft_png_rendered": { "type": "boolean" },
    "draft_png_path": { "anyOf": [{ "type": "null" }, { "const": "candidate-evidence/frame-review/lisa-presentation-generating-clock-13-24/draft-current-resolution.png" }] },
    "draft_png_sha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "draft_png_dimensions": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 521 }, "height": { "const": 3226 } } }] },
    "draft_png_non_white_pixel_count": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1000 }] },
    "owner_frame_approval": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_path", "decision", "decision_text", "decision_source", "approved_at"],
          "properties": {
            "record_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating-clock-13-24/owner-approval.json" },
            "decision": { "const": "approved" },
            "decision_text": { "const": "кадр принят" },
            "decision_source": { "const": "Product Owner в рабочем чате" },
            "approved_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "svg_source_prepared_pending_visual_check" } }, "required": ["status"] }, "then": { "properties": { "draft_png_rendered": { "const": false }, "draft_png_path": { "type": "null" }, "draft_png_sha256": { "type": "null" }, "draft_png_dimensions": { "type": "null" }, "draft_png_non_white_pixel_count": { "type": "null" }, "owner_frame_approval": { "type": "null" } } }, "else": { "properties": { "draft_png_rendered": { "const": true }, "draft_png_path": { "const": "candidate-evidence/frame-review/lisa-presentation-generating-clock-13-24/draft-current-resolution.png" }, "draft_png_sha256": { "$ref": "#/$defs/sha256" }, "draft_png_dimensions": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 521 }, "height": { "const": 3226 } } }, "draft_png_non_white_pixel_count": { "type": "integer", "minimum": 1000 } } } },
    { "if": { "properties": { "status": { "const": "owner_frame_approved" } }, "required": ["status"] }, "then": { "properties": { "owner_frame_approval": { "type": "object" } } }, "else": { "properties": { "owner_frame_approval": { "type": "null" } } } }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
