    "visual_reference_archive": {
      "type": "object", "additionalProperties": false,
      "required": ["file_name", "source_sha256", "member_count", "data_classification", "raw_archive_tracked", "source_path_stored", "embedded_raw_svg_allowed", "source_svg_persisted", "treatment", "source_catalog", "snapshot_renderer", "foreign_object_policy", "source_only_fragment"],
      "properties": {
        "file_name": { "const": "DialogFile3255926770227232252.zip" },
        "source_sha256": { "const": "b755549c84e059b8d999fcc12e55f6c3903aafe549935b90f2f1b84bb7852026" },
        "member_count": { "const": 25 },
        "data_classification": { "const": "synthetic" },
