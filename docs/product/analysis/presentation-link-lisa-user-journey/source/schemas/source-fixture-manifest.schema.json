{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-fixture-manifest.schema.json",
  "title": "Манифест очищенного происхождения растровых основ Лисы",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "product_backlog", "visual_reference_archive", "transient_raster_text_font", "approved_presentation_pdfs", "trust", "copied_executable_code", "active_external_links", "absolute_local_paths_stored"],
  "properties": {
    "$schema": { "const": "schemas/source-fixture-manifest.schema.json" },
    "version": { "const": "2.3.0" },
    "status": { "const": "active" },
    "product_backlog": { "$ref": "#/$defs/product_backlog" },
    "visual_reference_archive": { "$ref": "#/$defs/visual_reference_archive" },
    "transient_raster_text_font": { "$ref": "#/$defs/transient_font" },
    "approved_presentation_pdfs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/szh_dense_slidedoc_pdf" },
        { "$ref": "#/$defs/szh_dense_sber2025_pdf" },
        { "$ref": "#/$defs/szh_dense_mag_pdf" }
      ],
      "items": false
    },
    "trust": { "const": "untrusted-data-only" },
    "copied_executable_code": { "const": false },
    "active_external_links": { "const": false },
    "absolute_local_paths_stored": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pdf_page_dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 960 },
        "height": { "const": 540 }
      }
    },
    "pdf_rendered_dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 3840 },
        "height": { "const": 6480 }
      }
    },
    "presentation_pdf_common": {
      "type": "object", "additionalProperties": false,
      "required": ["file_name", "source_sha256", "output_sha256", "page_count", "page_dimensions", "scale", "rendered_dimensions", "output_file", "raw_file_tracked", "source_path_stored", "copied_to_package"],
      "properties": {
        "file_name": { "type": "string" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "page_count": { "const": 3 },
        "page_dimensions": { "$ref": "#/$defs/pdf_page_dimensions" },
        "scale": { "const": 4 },
        "rendered_dimensions": { "$ref": "#/$defs/pdf_rendered_dimensions" },
        "output_file": { "type": "string" },
        "raw_file_tracked": { "const": false },
        "source_path_stored": { "const": false },
        "copied_to_package": { "const": false }
      }
    },
    "szh_dense_slidedoc_pdf": {
      "allOf": [
        { "$ref": "#/$defs/presentation_pdf_common" },
        {
          "type": "object",
          "properties": {
            "file_name": { "const": "szh_dense_slidedoc.pdf" },
            "source_sha256": { "const": "f28bb0685c4788cdf9d81366531ae8d0847921dd53042406d5b7ef9212a5b569" },
            "output_sha256": { "const": "d056230b819da65682014741076b0faad9b5a9a513a378d6d61d11baf466fe32" },
