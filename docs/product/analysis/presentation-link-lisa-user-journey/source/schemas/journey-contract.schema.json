{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journey-contract.schema.json",
  "title": "Договор маршрута заказа презентации с сохранением отображаемой нумерации",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "initial_state_id",
    "state_ids",
    "states",
    "actions",
    "lifecycle",
    "navigation",
    "device"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/journey-contract.schema.json"
    },
    "version": {
      "const": "3.0.0"
    },
    "initial_state_id": {
      "$ref": "#/$defs/state_id"
    },
    "state_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/state_id"
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "navigation": {
      "$ref": "#/$defs/navigation"
    },
    "device": {
      "$ref": "#/$defs/device"
    }
  },
  "$defs": {
    "state_id": {
      "type": "string",
      "pattern": "^lisa-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|szh-dense-[a-z0-9]+(?:-[a-z0-9]+)*|status-[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "display_order",
        "source_id",
        "caption",
        "presentation",
        "scrollable",
        "action_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/state_id"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "display_order": {
          "type": "integer",
          "minimum": 1
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "enum": [
            "phone",
            "desktop"
          ]
        },
        "scrollable": {
          "type": "boolean"
        },
        "action_ids": {
          "type": "array",
          "items": {
            "const": "order-presentation"
          },
          "uniqueItems": true,
          "maxItems": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_state_id",
        "source_state_ids"
      ],
      "properties": {
        "id": {
          "const": "order-presentation"
        },
        "target_state_id": {
          "$ref": "#/$defs/state_id"
        },
        "source_state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_id"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "content_review_status",
        "visual_release_status",
        "states",
        "button",
        "single_order_lock",
        "chat",
        "scope",
        "delivery_variants",
        "screen_sequence",
        "messages"
      ],
      "properties": {
        "model": {
          "const": "variant"
        },
        "content_review_status": {
          "enum": [
            "pending_product_owner",
            "approved_product_owner"
          ]
        },
        "visual_release_status": {
          "enum": [
            "pending_product_owner",
            "approved_product_owner"
          ]
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lifecycle_state"
          }
        },
        "button": {
          "$ref": "#/$defs/lifecycle_button"
        },
        "single_order_lock": {
          "$ref": "#/$defs/single_order_lock"
        },
        "chat": {
          "$ref": "#/$defs/chat"
        },
        "scope": {
          "$ref": "#/$defs/q4_scope"
        },
        "delivery_variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/delivery_variant"
          }
        },
        "screen_sequence": {
          "$ref": "#/$defs/screen_sequence"
        },
        "messages": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/lifecycle_message"
          }
        }
      }
    },
    "lifecycle_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "next_state_ids"
      ],
      "properties": {
        "id": {
          "enum": [
            "eligible",
            "validating",
            "rejected_retryable",
            "accepted_locked",
            "generating",
            "delivery_confirmed",
            "delayed",
            "delivery_partial",
            "support_pending",
            "session_closed"
          ]
        },
        "next_state_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifecycle_button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_state_ids",
        "enabled_in",
        "disabled_in",
        "submission",
        "retry_after"
      ],
      "properties": {
        "source_state_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_id"
          }
        },
        "enabled_in": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disabled_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "submission": {
          "const": "immediate_without_confirmation"
        },
        "retry_after": {
          "const": "rejected_retryable"
        }
      }
    },
    "single_order_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "locks_on",
        "duplicate_behavior"
      ],
      "properties": {
        "scope": {
          "const": "session_user_pair"
        },
        "locks_on": {
          "const": "accepted_locked"
        },
        "duplicate_behavior": {
          "const": "reject_after_acceptance"
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery",
        "persistence",
        "system_push",
        "safe_message_only"
      ],
      "properties": {
        "delivery": {
          "const": "same_chat_on_return"
        },
        "persistence": {
          "const": true
        },
        "system_push": {
          "const": false
        },
        "safe_message_only": {
          "const": true
        }
      }
    },
    "q4_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_link",
        "separate_storage",
        "rich_structure_editing"
      ],
      "properties": {
        "result_link": {
          "const": false
        },
        "separate_storage": {
          "const": false
        },
        "rich_structure_editing": {
          "const": false
        }
      }
    },
    "delivery_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contour_count"
      ],
      "properties": {
        "id": {
          "enum": [
            "one_contour",
            "two_contours"
          ]
        },
        "contour_count": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "lifecycle_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decision_id",
        "message_id",
        "authoritative_text_status",
        "authoritative_text"
      ],
      "properties": {
        "id": {
          "enum": [
            "order_started",
            "order_not_accepted",
            "delivery_confirmed",
            "delivery_delayed",
            "delivery_partial"
          ]
        },
        "decision_id": {
          "const": "CO3-DEC-007"
        },
        "message_id": {
          "type": "string",
          "pattern": "^CO3-MSG-\\d{3}$"
        },
        "authoritative_text_status": {
          "const": "agreed"
        },
        "authoritative_text": {
          "type": "string",
          "minLength": 1
        },
        "contour_display_rule": {
          "const": "by_actual_address_lookup"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "delivery_partial"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "contour_display_rule": {
                "const": "by_actual_address_lookup"
              }
            },
            "required": [
              "contour_display_rule"
            ]
          }
        }
      ]
    },
    "screen_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "preserve_existing_source_order",
        "existing_state_ids",
        "additional_status_state_ids",
        "status_presentations",
        "additional_status_placement",
        "delivery_failure_presentation",
        "generation_status"
      ],
      "properties": {
        "decision_id": {
          "const": "CO3-DEC-009"
        },
        "preserve_existing_source_order": {
          "const": true
        },
        "existing_state_ids": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_id"
          }
        },
        "additional_status_state_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_id"
          }
        },
        "status_presentations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state_id",
              "base_state_id",
              "source_id",
              "lifecycle_message_id",
              "prototype_preview_text",
              "caption"
            ],
            "properties": {
              "state_id": {
                "$ref": "#/$defs/state_id"
              },
              "base_state_id": {
                "enum": [
                  "lisa-presentation-generating",
                  "lisa-presentation-sent"
                ]
              },
              "source_id": {
                "enum": [
                  "status-order-not-accepted",
                  "status-delivery-delayed",
                  "status-delivery-partial"
                ]
              },
              "lifecycle_message_id": {
                "enum": [
                  "order_not_accepted",
                  "delivery_delayed",
                  "delivery_partial"
                ]
              },
              "prototype_preview_text": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "additional_status_placement": {
          "const": "after_existing_presentation_states"
        },
        "delivery_failure_presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_id",
            "presentation_state_id",
            "lifecycle_message_id",
            "separate_screen"
          ],
          "properties": {
            "decision_id": {
              "const": "CO3-DEC-009"
            },
            "presentation_state_id": {
              "const": "lisa-delivery-partial"
            },
            "lifecycle_message_id": {
              "const": "delivery_partial"
            },
            "separate_screen": {
              "const": false
            }
          }
        },
        "generation_status": {
          "enum": [
            "source_ready_visual_generation_not_run",
            "visual_generation_completed"
          ]
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "wrap",
        "display_total",
        "keyboard"
      ],
      "properties": {
        "mode": {
          "const": "linear"
        },
        "wrap": {
          "const": false
        },
        "display_total": {
          "type": "integer",
          "minimum": 1
        },
        "keyboard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previous",
            "next",
            "activate"
          ],
          "properties": {
            "previous": {
              "type": "string",
              "minLength": 1
            },
            "next": {
              "type": "string",
              "minLength": 1
            },
            "activate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "body_mm",
        "screen_px",
        "inner_window_px",
        "source_body_viewport",
        "source_canvas_margins"
      ],
      "properties": {
        "model": {
          "const": "iPhone 12 Pro Max"
        },
        "body_mm": {
          "$ref": "#/$defs/body_mm"
        },
        "screen_px": {
          "$ref": "#/$defs/screen_px"
        },
        "inner_window_px": {
          "$ref": "#/$defs/phone_viewport"
        },
        "source_body_viewport": {
          "$ref": "#/$defs/source_body_viewport"
        },
        "source_canvas_margins": {
          "$ref": "#/$defs/source_canvas_margins"
        }
      }
    },
    "body_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "const": 78.1
        },
        "height": {
          "const": 160.8
        }
      }
    },
    "screen_px": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "const": 428
        },
        "height": {
          "const": 926
        }
      }
    },
    "phone_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "const": 521
        },
        "height": {
          "const": 980
        }
      }
    },
    "source_body_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "const": 64
        },
        "y": {
          "const": 48
        },
        "width": {
          "const": 393
        },
        "height": {
          "const": 852
        }
      }
    },
    "source_canvas_margins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "const": 64
        },
        "top": {
          "const": 48
        },
        "right": {
          "const": 64
        },
        "bottom": {
          "const": 80
        }
      }
    }
  }
}
