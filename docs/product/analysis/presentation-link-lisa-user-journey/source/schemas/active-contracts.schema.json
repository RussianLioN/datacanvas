{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "active-contracts.schema.json",
  "title": "Реестр активных договоров десятиэкранного маршрута Лисы",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "route_id",
    "active_state_ids",
    "active_contracts",
    "inactive_contract_policy"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/active-contracts.schema.json"
    },
    "version": {
      "const": "3.0.0"
    },
    "status": {
      "const": "active"
    },
    "route_id": {
      "const": "lisa-presentation-ten-screen-route"
    },
    "active_state_ids": {
      "const": [
        "lisa-materials-summary",
        "lisa-materials-full-reference",
        "lisa-presentation-order",
        "lisa-presentation-generating",
        "lisa-presentation-chat-list",
        "lisa-presentation-sent",
        "lisa-presentation-email",
        "lisa-presentation-slidedoc",
        "lisa-presentation-sber2025",
        "lisa-presentation-mag"
      ]
    },
    "active_contracts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/journey"
        },
        {
          "$ref": "#/$defs/frame"
        },
        {
          "$ref": "#/$defs/source_render_catalog"
        },
        {
          "$ref": "#/$defs/visual_basis"
        },
        {
          "$ref": "#/$defs/prototype_package"
        },
        {
          "$ref": "#/$defs/scope"
        }
      ],
      "items": false
    },
    "inactive_contract_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_twenty_state_route_active",
        "inactive_contracts_are_not_generator_inputs",
        "active_registry_is_single_source"
      ],
      "properties": {
        "old_twenty_state_route_active": {
          "const": false
        },
        "inactive_contracts_are_not_generator_inputs": {
          "const": true
        },
        "active_registry_is_single_source": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "journey": {
      "allOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "journey"
            },
            "path": {
              "const": "source/journey-contract.json"
            },
            "schema": {
              "const": "source/schemas/journey-contract.schema.json"
            }
          }
        }
      ]
    },
    "frame": {
      "allOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "frame"
            },
            "path": {
              "const": "source/frame-contract.json"
            },
            "schema": {
              "const": "source/schemas/frame-contract.schema.json"
            }
          }
        }
      ]
    },
    "source_render_catalog": {
      "allOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "source-render-catalog"
            },
            "path": {
              "const": "source/source-render-catalog.json"
            },
            "schema": {
              "const": "source/schemas/source-render-catalog.schema.json"
            }
          }
        }
      ]
    },
    "visual_basis": {
      "allOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "visual-basis"
            },
            "path": {
              "const": "source/visual-basis-contract.json"
            },
            "schema": {
              "const": "source/schemas/visual-basis-contract.schema.json"
            }
          }
        }
      ]
    },
    "prototype_package": {
      "allOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "prototype-package"
            },
            "path": {
              "const": "source/prototype-package-contract.json"
            },
            "schema": {
              "const": "source/schemas/prototype-package-contract.schema.json"
            }
          }
        }
      ]
    },
    "scope": {
      "allOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "scope"
            },
            "path": {
              "const": "source/prototype-scope-contract.json"
            },
            "schema": {
              "const": "source/schemas/prototype-scope-contract.schema.json"
            }
          }
        }
      ]
    }
  }
}
