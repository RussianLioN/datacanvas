  "state_rules": {
    "lisa-materials-full-reference": {"phone_time": "13:24", "initial_scroll_position": "top", "button_state": "enabled"},
    "lisa-presentation-generating": {"phone_time": "13:24", "initial_scroll_position": "bottom", "button_state": "disabled"},
    "lisa-presentation-chat-list": {"phone_time": "13:40", "initial_scroll_position": "top", "button_state": "absent"},
    "lisa-presentation-sent": {"phone_time": "13:40", "initial_scroll_position": "bottom", "button_state": "disabled"},
    "lisa-order-not-accepted": {"phone_time": "13:40", "initial_scroll_position": "bottom", "button_state": "disabled"},
    "lisa-delivery-delayed": {"phone_time": "13:40", "initial_scroll_position": "bottom", "button_state": "disabled"},
    "lisa-delivery-partial": {"phone_time": "13:40", "initial_scroll_position": "bottom", "button_state": "disabled"}
