    {"from": "lisa-presentation-generating", "event": "data_not_accepted", "to": "lisa-order-not-accepted"},
    {"from": "lisa-presentation-generating", "event": "delivery_delayed", "to": "lisa-delivery-delayed"},
    {"from": "lisa-presentation-generating", "event": "delivery_unconfirmed", "to": "lisa-delivery-partial"},
    {"from": "lisa-presentation-sent", "event": "open_delivery_email", "to": "lisa-presentation-email"}
