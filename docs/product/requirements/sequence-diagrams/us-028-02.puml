@startuml
!pragma teoz true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #6B7280
  ParticipantBorderColor #2C3E50
  ParticipantBackgroundColor #F8FAFC
  ParticipantFontColor #111827
  ActorBorderColor #2C3E50
  ActorBackgroundColor #EFF6FF
  ActorFontColor #111827
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}
title US-028-02 — Передача обращения в сопровождение

participant "DataCanvas" as datacanvas
participant "Жизненный цикл заказа" as lifecycle
participant "Сопровождение" as support

autonumber
datacanvas -> lifecycle: Фиксирует безопасный признак проблемы
datacanvas -> support: Передаёт контекст обращения
support -> lifecycle: Разбирает жизненный цикл заказа
alt Передача подтверждена
  support --> datacanvas: Подтверждает приём обращения
else Передача не подтверждена
  support --> datacanvas: Не выдаёт ложное решение проблемы
end
@enduml
