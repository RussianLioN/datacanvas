@startuml
!pragma teoz true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #6B7280
  ParticipantBorderColor #2C3E50
  ParticipantBackgroundColor #F8FAFC
  ParticipantFontColor #111827
  ActorBorderColor #2C3E50
  ActorBackgroundColor #EFF6FF
  ActorFontColor #111827
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}
title US-026-02 — Проверка права и связи заказа

participant "Вызывающий агент" as caller
participant "DataCanvas" as datacanvas
participant "Проверка заказа" as validation

autonumber
caller -> datacanvas: Передаёт заказ с признаками связи
datacanvas -> validation: Проверяет право и связь контекста
alt Связь подтверждена
  validation --> datacanvas: Допускает заказ к подготовке
else Связь не подтверждена
  validation --> datacanvas: Не принимает заказ
  datacanvas --> caller: Возвращает безопасный итог
end
@enduml
