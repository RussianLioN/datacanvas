@startuml
!pragma teoz true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #6B7280
  ParticipantBorderColor #2C3E50
  ParticipantBackgroundColor #F8FAFC
  ParticipantFontColor #111827
  ActorBorderColor #2C3E50
  ActorBackgroundColor #EFF6FF
  ActorFontColor #111827
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}
title US-027-01 — Сообщение о начале подготовки

actor "Пользователь" as user
participant "Лиса" as lisa
participant "Агент\n«Справка по клиенту»" as client
participant "DataCanvas" as datacanvas

autonumber
datacanvas --> client: Подтверждает безопасное принятие заказа
client -> lisa: Передаёт начало подготовки
lisa -> user: Показывает сообщение в продолжении справки
lisa -> user: Делает действие создания недоступным
alt Заказ не принят
  datacanvas --> client: Возвращает безопасный результат непринятия
  client -> lisa: Показывает результат в контексте справки
end
@enduml
