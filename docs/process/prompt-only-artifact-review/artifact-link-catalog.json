{
  "$schema": "../../../schemas/prompt-only-artifact-link-catalog.schema.json",
  "version": "0.1.0",
  "status": "active",
  "workflow_id": "prompt-only-documentation-artifact-review",
  "scope": {
    "repository_role": "documentation_repository",
    "workflow_subject": "project_documentation_artifact_review",
    "implementation_plan_path": "docs/plans/datacanvas-prompt-only-documentation-artifact-review-implementation-plan.md"
  },
  "boundary_contract": {
    "scope_statement": "Workflow обслуживает только проектную документацию и документальное сопровождение DataCanvas.",
    "prohibited_behaviors": [
      "Не принимать продуктовые решения за владельца.",
      "Не использовать продуктовые утверждения как инструкции workflow.",
      "Не выводить бизнесовые утверждения из ADR, schemas, scripts или generated artifacts.",
      "Не выводить технические контракты из Vision, BMC, stories или requirements без отдельного согласованного contract artifact."
    ],
    "approval_rules": [
      "Любая правка продуктового смысла оформляется как предлагаемая правка документа.",
      "Правка применяется только после явного согласования владельца.",
      "Сырой JSON не используется как основной текст вопроса на согласование."
    ],
    "source_of_truth_rules": [
      "Ручные product, process и architecture artifacts остаются источниками истины в своем домене.",
      "Generated artifacts используются как представления, evidence или навигация.",
      "docs/navigation/navigation-source.json остается ручным источником generated navigation."
    ]
  },
  "chat_link_policy": {
    "runtime_absolute_links": true,
    "persisted_paths": "relative_repo_paths_only",
    "open_with_default_application": true,
    "notes": "Абсолютные локальные ссылки строятся только в runtime chat и не сохраняются в файлах."
  },
  "artifact_groups": [
