  "state_machine": {
    "initial_status": "initialized",
    "terminal_statuses": [
      "completed",
      "abandoned"
    ],
    "statuses": [
      "initialized",
      "intake_validated",
      "inventory_completed",
      "methodology_checked",
      "impact_analyzed",
      "awaiting_decision",
      "approved_to_apply",
      "applying_changes",
      "generating",
      "validating",
      "blocked",
      "recovery_required",
      "completed",
      "abandoned"
    ],
    "transitions": [
      {
        "from": "initialized",
        "to": "intake_validated"
      },
      {
        "from": "intake_validated",
        "to": "inventory_completed"
      },
      {
        "from": "inventory_completed",
        "to": "methodology_checked"
      },
      {
        "from": "methodology_checked",
        "to": "impact_analyzed"
      },
      {
        "from": "impact_analyzed",
        "to": "awaiting_decision"
      },
      {
        "from": "impact_analyzed",
        "to": "approved_to_apply"
      },
      {
        "from": "approved_to_apply",
        "to": "applying_changes"
      },
      {
        "from": "applying_changes",
        "to": "generating"
      },
      {
        "from": "generating",
        "to": "validating"
      },
      {
        "from": "validating",
        "to": "completed"
      },
      {
        "from": "blocked",
        "to": "recovery_required"
      }
    ]
