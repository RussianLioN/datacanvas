{
  "$schema": "../../../schemas/mutation-guard-policy.schema.json",
  "version": "0.1.0",
  "status": "active",
  "policy_id": "mutation-guard-universal-documentation-workflow",
  "generated_artifact_policy": {
    "manual_edit_allowed": false,
    "source_then_generate_required": true,
    "unexpected_write_action": "block_completion"
  },
  "allowed_write_sets": [
    {
      "generator_id": "datacanvas-xlsx-sanitized-reference",
      "allowed_writes": [
        "docs/product/sources/reference/datacanvas-backlog-source-sanitized.xlsx",
        "docs/product/sources/reference/datacanvas-backlog-source-sanitization.json"
      ]
    },
    {
      "generator_id": "datacanvas-xlsx-backlog-2026-08-17-working",
      "allowed_writes": [
        "docs/product/sources/working/datacanvas-backlog-draft-pshe-2026-08-17.xlsx",
        "docs/product/sources/working/datacanvas-backlog-draft-pshe-2026-08-17.provenance.json"
      ]
    },
    {
      "generator_id": "datacanvas-jira-stories",
      "allowed_writes": [
        "artifacts/generated/jira/datacanvas-stories-dc-st-23-dc-st-33.csv"
      ]
    },
    {
      "generator_id": "docs-navigation",
      "allowed_writes": [
        "docs/navigation/documentation-index.json",
        "docs/navigation/navigation-map.md",
        "docs/navigation/orphan-docs-report.md",
        "docs/navigation/stale-status-report.md"
      ]
    },
    {
      "generator_id": "process-metrics-snapshot",
      "allowed_writes": [
        "docs/process/current/process-metrics-snapshot.json",
        "docs/process/current/process-metrics-snapshot.md"
      ]
    },
    {
      "generator_id": "artifact-hash-manifest",
      "allowed_writes": [
        "docs/architecture/schemas/artifact-hash-manifest.json"
      ]
    },
    {
      "generator_id": "datacanvas-bmc",
      "allowed_writes": [
        "docs/product/bmc/bmc-v0.2.md",
        "docs/product/bmc/source/derived/datacanvas-bmc.puml",
        "docs/product/bmc/source/derived/datacanvas-bmc.svg",
        "docs/product/bmc/source/derived/datacanvas-bmc.png",
        "docs/product/bmc/source/derived/datacanvas-bmc.pdf",
        "docs/product/bmc/bmc-validation-needs.json",
        "docs/product/bmc/bmc-derived-manifest.json",
        "docs/product/bmc/README.md",
        "docs/product/bmc/source-map.md",
        "docs/product/bmc/text-alternative.md",
        "docs/product/bmc/evidence/bmc-visual-design-philosophy.md",
        "docs/product/bmc/evidence/bmc-visual-acceptance.json",
        "docs/product/bmc/evidence/designer-consilium.json",
        "docs/product/bmc/evidence/visual-review.md",
        "docs/product/bmc/manifest.json"
      ]
    },
    {
      "generator_id": "documentation-cascade-run",
      "allowed_writes": [],
      "allowed_write_roots": [
        "docs/process/cascading-governance/runs"
      ]
    },
    {
      "generator_id": "documentation-cascade-finalization",
      "allowed_writes": [],
      "allowed_write_roots": [
        "docs/process/cascading-governance/runs"
      ]
    },
    {
      "generator_id": "documentation-cascade-verification",
      "allowed_writes": [],
      "allowed_write_roots": [
        "docs/process/cascading-governance/runs"
      ]
    },
    {
      "generator_id": "documentation-cascade-completion",
      "allowed_writes": [],
      "allowed_write_roots": [
        "docs/process/cascading-governance/runs"
      ]
    },
    {
      "generator_id": "documentation-archive",
      "allowed_writes": [
        "artifacts/documentation-archive/datacanvas-main-documentation.zip"
      ]
    },
    {
      "generator_id": "co-2026-003-prototype-delivery-archive",
      "allowed_writes": [
        "artifacts/delivery/co-2026-003-q4-lisa-profile-delivery.zip"
      ]
    }
  ],
  "blocked_patterns": [
    {
      "id": "path-traversal",
      "pattern": "../",
      "reason": "Allowed writes must stay inside repository paths."
    },
    {
      "id": "absolute-path",
      "pattern": "/Users/",
      "reason": "Persisted mutation guard paths must be relative repository paths."
    }
  ],
  "negative_fixture_path": "tests/fixtures/universal-documentation-workflow/negative/scenarios.json"
}
