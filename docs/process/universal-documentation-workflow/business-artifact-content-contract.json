      "allowed_h2": [
        "Назначение",
        "Пакет импорта",
        "Порядок публикации",
        "Открытые вопросы"
      ]
    },
    {
      "class_name": "roadmap",
      "purpose": "Дорожная карта продукта.",
      "business_scope": "Описывает порядок продуктовой поставки и gates без копирования backlog, пользовательских историй, технических контрактов или evidence-журналов.",
      "required_h2": [
        "Порядок Поставки"
      ],
      "allowed_h2": [
        "Порядок Поставки"
      ]
    },
    {
      "class_name": "hypothesis_board",
      "purpose": "Доска продуктовых гипотез.",
      "business_scope": "Хранит только гипотезы о ценности, качестве или результате продукта; процессные эксперименты и sprint metrics выносятся в процессный контур.",
      "required_h2": [
        "Назначение",
        "Продуктовые Гипотезы"
      ],
      "allowed_h2": [
        "Назначение",
        "Продуктовые Гипотезы"
      ]
    },
    {
      "class_name": "hypothesis_validation",
      "purpose": "План проверки продуктовых гипотез.",
      "business_scope": "Описывает, как проверять гипотезы из доски, без повторного хранения текста гипотез как второго канона.",
      "required_h2": [
        "Назначение",
        "План Проверки",
        "Правило Решения",
        "Текущие Проверочные Свидетельства"
      ],
      "allowed_h2": [
        "Назначение",
        "План Проверки",
        "Правило Решения",
        "Текущие Проверочные Свидетельства"
      ]
    }
