      "purpose": "Производный срез пользовательских историй по принятым приоритетам для оценки командой.",
      "business_scope": "Содержит только идентификаторы, приоритеты, раздельные статусы принятия Product Owner и оценки команды, а также ссылку на канонический каталог; не повторяет полный текст пользовательских историй и не обещает календарный срок до оценки команды.",
      "required_h2": [
        "Назначение",
        "Срез По Приоритетам"
      ],
      "allowed_h2": [
        "Назначение",
        "Срез По Приоритетам",
        "CSV"
      ]
    },
    {
      "class_name": "story_slice_export",
      "purpose": "Рабочий экспорт среза пользовательских историй.",
      "business_scope": "CSV может повторять полный текст пользовательских историй только как экспорт канонического каталога, но не должен добавлять служебные поля, пути, команды, хэши или provenance.",
      "allowed_business_terms": [
        {
          "rule_id": "technical-contract",
          "terms": [
            "обратный вызов"
          ],
          "required_context_pattern": "^\"DC-ST-27\",",
          "rationale": "CSV повторяет принятую Product Owner формулировку DC-ST-27 из канонического каталога и не является самостоятельным источником технического контракта."
        },
        {
          "rule_id": "technical-contract",
          "terms": [
            "trace ID"
          ],
          "required_context_pattern": "^\"DC-ST-28\",",
          "rationale": "CSV повторяет принятую Product Owner формулировку DC-ST-28 из канонического каталога и не является самостоятельным источником технической трассировки."
        }
      ]
    },
    {
      "class_name": "confluence_export",
      "purpose": "Карта экспорта в Confluence.",
      "business_scope": "Описывает импортируемый комплект и маршрут публикации, но не заменяет исходные бизнесовые артефакты.",
      "required_h2": [
        "Назначение",
        "Пакет импорта",
        "Порядок публикации",
        "Открытые вопросы"
