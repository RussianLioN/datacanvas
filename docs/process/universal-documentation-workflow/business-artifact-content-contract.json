  "global_forbidden_patterns": [
    {
      "id": "local-path",
      "pattern": "(?:/Users/|file://)",
      "message": "Локальные абсолютные пути нельзя хранить в бизнесовом Markdown-артефакте."
    },
    {
      "id": "raw-json-block",
      "pattern": "```(?:json|yaml|yml)",
      "message": "Сырой JSON/YAML не должен быть основным содержанием бизнесового Markdown-артефакта."
    },
    {
      "id": "generation-runtime",
      "pattern": "(?:npm run|node scripts/|generated at|sha256|checksum|provenance|artifact hash)",
      "message": "Команды, хэши, provenance и runtime-детали нужно выносить в машинночитаемые или процессные артефакты."
    }
  ]
}
