      "required_h2": [
        "Назначение",
        "Нефункциональные требования",
        "Открытые вопросы"
      ],
      "allowed_h2": [
        "Назначение",
        "Нефункциональные требования",
        "Открытые вопросы"
      ]
    },
    {
