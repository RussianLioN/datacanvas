      "required_h2": [
        "Актуальный Источник"
      ],
      "allowed_h2": [
        "Актуальный Источник"
      ]
    },
    {
      "class_name": "story_catalog",
      "purpose": "Канонический каталог пользовательских историй продукта.",
      "business_scope": "Документ содержит только бизнесовое описание историй, приоритет, функциональную зону и бизнес-ценность. Источники, правила слияния, даты, ПШЕ, техническая трассировка, открытые решения и служебная методика хранятся во внешних машиночитаемых или процессных артефактах.",
      "required_h2": [
        "Назначение",
        "Каталог пользовательских историй"
      ],
      "allowed_h2": [
        "Назначение",
        "Каталог пользовательских историй"
      ],
      "forbidden_h2": [
        "Сводка по приоритетам и срокам",
        "Источники и правила слияния",
        "Группировка по функциональным зонам",
        "Открытые продуктовые решения",
        "Открытые решения",
        "Методика",
        "Граница модели",
        "Статус",
        "Термины"
      ],
      "required_table_columns": [
        "ID",
        "Функциональная зона",
        "Приоритет",
        "Пользовательская формулировка",
        "Бизнес-ценность"
      ],
      "forbidden_table_columns": [
        "Плановый срок",
        "Статус",
        "ПШЕ",
        "Оценка",
        "Источник",
        "Примечание",
        "Решение",
        "Трассировка"
      ],
      "immutable_table_columns": [
        "Пользовательская формулировка",
        "Бизнес-ценность"
      ],
      "allowed_business_terms": []
    },
    {
