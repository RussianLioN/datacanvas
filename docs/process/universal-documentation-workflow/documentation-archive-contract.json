      "path": "docs/product/bmc/source/derived/datacanvas-bmc.puml",
      "label": "BMC — исходное представление PlantUML"
    },
    {
      "path": "docs/product/bmc/source/derived/datacanvas-bmc.svg",
      "label": "BMC — векторное представление SVG"
    },
    {
      "path": "docs/product/bmc/source/derived/datacanvas-bmc.png",
      "label": "BMC — растровое представление PNG"
    },
    {
      "path": "docs/product/bmc/source/derived/datacanvas-bmc.pdf",
      "label": "BMC — представление PDF"
    },
    {
      "path": "docs/product/backlog/agent-launch-candidate-stories-2026-q3.csv",
      "label": "Выгрузка кандидатных историй бэклога CSV"
    },
    {
      "path": "docs/product/sources/reference/datacanvas-backlog-source-sanitized.xlsx",
