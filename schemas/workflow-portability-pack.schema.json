{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/workflow-portability-pack.schema.json",
  "title": "WorkflowPortabilityPack",
  "type": "object",
  "required": ["$schema", "version", "status", "pack_id", "source_workflow", "templates", "implementation_phases", "migration_notes_template", "validation_commands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "ready_for_pilot_feedback", "accepted"] },
    "pack_id": { "type": "string", "minLength": 1 },
    "source_workflow": { "type": "string", "minLength": 1 },
    "templates": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["template_id", "artifact_kind", "schema_path", "description"],
        "additionalProperties": false,
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "artifact_kind": { "type": "string", "minLength": 1 },
          "schema_path": { "type": ["string", "null"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementation_phases": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
    "migration_notes_template": {
      "type": "object",
      "required": ["required_headings"],
      "additionalProperties": false,
      "properties": {
        "required_headings": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "validation_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
