{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-owner-question-packet.schema.json",
  "title": "Cascade owner question packet v1",
  "type": "object",
  "required": ["$schema", "version", "packet_id", "decision_id", "owner_role", "question", "source_excerpts", "affected_artifacts", "options", "recommended_option_id", "packet_sha256"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-owner-question-packet.schema.json" },
    "version": { "const": "1.0.0" },
    "packet_id": { "type": "string", "pattern": "^QPK-[A-Z0-9-]+$" },
    "decision_id": { "type": "string", "pattern": "^DEC-[A-Z0-9-]+$" },
    "owner_role": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "source_excerpts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "excerpt", "excerpt_sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "excerpt": { "type": "string", "minLength": 1 },
          "excerpt_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
        }
      }
    },
    "affected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["option_id", "text", "consequences"],
        "additionalProperties": false,
        "properties": {
          "option_id": { "type": "string", "pattern": "^OPT-[A-Z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 },
          "consequences": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommended_option_id": { "type": "string", "pattern": "^OPT-[A-Z0-9-]+$" },
    "packet_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
  }
}
