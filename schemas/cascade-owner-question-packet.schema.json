{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-owner-question-packet.schema.json",
  "title": "Cascade owner question packet v1",
  "type": "object",
  "required": ["$schema", "version", "packet_id", "decision_id", "required_owner_roles", "change_classes", "authority_manifest_path", "authority_manifest_sha256", "question", "source_excerpts", "affected_artifacts", "options", "recommended_option_id", "packet_sha256"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-owner-question-packet.schema.json" },
    "version": { "const": "1.0.0" },
    "packet_id": { "type": "string", "pattern": "^QPK-[A-Z0-9-]+$" },
    "decision_id": { "type": "string", "pattern": "^DEC-[A-Z0-9-]+$" },
    "required_owner_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Product Owner", "Process Owner", "Команда реализации"] } },
    "change_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/cascadeChangeClass" } },
    "authority_manifest_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
    "authority_manifest_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "question": { "type": "string", "minLength": 1 },
    "source_excerpts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "excerpt", "excerpt_sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "excerpt": { "type": "string", "minLength": 1 },
          "excerpt_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
        }
      }
    },
    "affected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["option_id", "text", "consequences", "effect"],
        "additionalProperties": false,
        "properties": {
          "option_id": { "type": "string", "pattern": "^OPT-[A-Z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 },
          "consequences": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["authorize_apply", "reject_change", "block_pending_text", "block_deferred", "block_more_evidence"] }
        }
      }
    },
    "recommended_option_id": { "type": "string", "pattern": "^OPT-[A-Z0-9-]+$" },
    "packet_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
  }
}
