{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/security-foundation-manifest.schema.json",
  "title": "SecurityFoundationManifest",
  "type": "object",
  "required": ["version", "status", "required_artifacts", "required_gates", "stop_rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["active", "draft"] },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "owner_role"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^SEC-[0-9]{3}$" },
          "path": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
