{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/reprioritization-impact-report.schema.json",
  "title": "ReprioritizationImpactReport",
  "type": "object",
  "required": [
    "version",
    "report_id",
    "status",
    "change_request_id",
    "capacity_plan_id",
    "quarter",
    "capacity_status",
    "available_capacity_pse",
    "reserved_buffer_pse",
    "committed_items",
    "proposed_changes",
    "total_committed_pse",
    "capacity_delta_pse",
    "capacity_overrun",
    "dependencies",
    "trade_off_options",
    "blocking_decisions",
    "validation_commands"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/semver" },
    "report_id": { "type": "string", "pattern": "^RIR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["draft", "blocked", "ready", "confirmed", "not_applicable"] },
    "change_request_id": { "type": "string", "pattern": "^DCR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "capacity_plan_id": { "type": "string", "pattern": "^CAP-[0-9]{4}-Q[1-4]$" },
    "quarter": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/quarter" },
    "capacity_status": { "type": "string", "enum": ["available", "missing", "pending_external"] },
    "available_capacity_pse": { "type": ["number", "null"], "minimum": 0 },
    "reserved_buffer_pse": { "type": ["number", "null"], "minimum": 0 },
    "committed_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportItem" }
    },
    "proposed_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposedChange" }
    },
    "total_committed_pse": { "type": "number", "minimum": 0 },
    "capacity_delta_pse": { "type": ["number", "null"] },
    "capacity_overrun": { "type": "boolean" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "depends_on"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "trade_off_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_id", "description", "requires_user_confirmation", "status"],
        "additionalProperties": false,
        "properties": {
          "option_id": { "type": "string", "pattern": "^OPT-[A-Z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "requires_user_confirmation": { "type": "boolean" },
          "status": { "type": "string", "enum": ["proposed", "confirmed", "rejected", "not_applicable"] }
        }
      }
    },
    "blocking_decisions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DEC-[A-Z0-9-]+$" }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "reportItem": {
      "type": "object",
      "required": ["item_id", "title", "estimate_pse", "quarter"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "estimate_pse": { "type": "number", "minimum": 0 },
        "quarter": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/quarter" }
      }
    },
    "proposedChange": {
      "type": "object",
      "required": ["item_id", "from_quarter", "to_quarter", "estimate_pse", "user_confirmation_status"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "from_quarter": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/nullableQuarter" },
        "to_quarter": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/nullableQuarter" },
        "estimate_pse": { "type": "number", "minimum": 0 },
        "user_confirmation_status": { "type": "string", "enum": ["pending", "confirmed", "rejected", "not_required"] }
      }
    }
  }
}
