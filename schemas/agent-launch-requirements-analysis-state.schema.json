{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/agent-launch-requirements-analysis-state.schema.json",
  "title": "AgentLaunchRequirementsAnalysisState",
  "type": "object",
  "required": [
    "analysis_id",
    "status",
    "current_step",
    "current_story_or_artifact",
    "log_path",
    "requirements_impact_map_path",
    "completed_decisions",
    "deferred_decisions",
    "last_open_checkpoint",
    "continuation_rule",
    "validation_commands"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "analysis_id": { "type": "string", "pattern": "^ALRA-[0-9]{4}-[0-9]{3}$" },
    "status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "paused", "completed", "abandoned"]
    },
    "current_step": { "type": "string", "minLength": 1 },
    "current_story_or_artifact": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "log_path": { "$ref": "#/$defs/repoPath" },
    "requirements_impact_map_path": { "$ref": "#/$defs/repoPath" },
    "completed_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/completedDecision" }
    },
    "deferred_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/deferredDecision" }
    },
    "last_open_checkpoint": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/openCheckpoint" }
      ]
    },
    "continuation_rule": { "type": "string", "minLength": 1 },
    "validation_commands": {
      "type": "object",
      "required": ["light", "final"],
      "additionalProperties": false,
      "properties": {
        "light": { "type": "string", "minLength": 1 },
        "final": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "storyId": {
      "type": "string",
      "pattern": "^DC-ST-(23|24|25|26|27|28|29)$"
    },
    "completedDecision": {
      "type": "object",
      "required": ["decision_id", "story_id", "summary"],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string", "pattern": "^ALRA-DEC-[0-9]{3}$" },
        "story_id": { "$ref": "#/$defs/storyId" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "deferredDecision": {
      "type": "object",
      "required": ["decision_id", "story_id", "reason", "owner_role"],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string", "pattern": "^ALRA-DEC-[0-9]{3}$" },
        "story_id": { "$ref": "#/$defs/storyId" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 }
      }
    },
    "openCheckpoint": {
      "type": "object",
      "required": ["id", "reason", "owner_role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 }
      }
    }
  }
}
