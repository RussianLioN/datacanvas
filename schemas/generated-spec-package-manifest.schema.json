{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/generated-spec-package-manifest.schema.json",
  "title": "GeneratedSpecPackageManifest",
  "type": "object",
  "required": [
    "version",
    "status",
    "run_id",
    "package_id",
    "source_hashes",
    "generator_version",
    "schema_refs",
    "validation_results",
    "outputs",
    "rollback_signals"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "generated"] },
    "run_id": { "type": "string", "pattern": "^PRUN-[0-9]{4}-[0-9]{3}$" },
    "package_id": { "type": "string", "pattern": "^SPEC-PKG-[0-9]{4}-[0-9]{3}$" },
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "generator_version": { "type": "string", "minLength": 1 },
    "schema_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "not_run"] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "data_class", "visibility", "redaction_status"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "data_class": { "type": "string", "enum": ["internal", "confidential"] },
          "visibility": { "type": "string", "enum": ["internal", "restricted"] },
          "redaction_status": { "type": "string", "enum": ["not_required", "redacted", "metadata_only"] }
        }
      }
    },
    "rollback_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
