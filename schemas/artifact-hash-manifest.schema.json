{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/artifact-hash-manifest.schema.json",
  "title": "ArtifactHashManifest",
  "type": "object",
  "required": ["version", "status", "source_registry_path", "algorithm", "entries", "exclusions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["generated"] },
    "source_registry_path": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "enum": ["sha256"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^ART-[0-9]{3}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
