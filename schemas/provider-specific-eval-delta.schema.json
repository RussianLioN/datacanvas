{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/provider-specific-eval-delta.schema.json",
  "title": "ProviderSpecificEvalDelta",
  "type": "object",
  "required": ["delta_id", "schema_version", "linked_experiment_id", "provider_id", "cases"],
  "additionalProperties": false,
  "properties": {
    "delta_id": {
      "type": "string",
      "pattern": "^EVALDELTA-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "linked_experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Za-z0-9_-]+$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^PROVIDER-[0-9]+$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "expected", "linked_risk", "score_weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^EVAL-[0-9]+$" },
          "type": {
            "type": "string",
            "enum": ["provider_quality", "provider_latency", "provider_cost", "provider_failure", "provider_security"]
          },
          "description": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "linked_risk": { "type": "string", "minLength": 1 },
          "score_weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
