{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/impact-analysis-report.schema.json",
  "title": "ImpactAnalysisReport",
  "type": "object",
  "required": [
    "version",
    "impact_report_id",
    "change_request_id",
    "status",
    "generated_at",
    "target_artifact",
    "impact_cone",
    "affected_artifacts",
    "blocking_user_decisions",
    "derived_facts",
    "assumptions_forbidden",
    "proposals",
    "validation_plan",
    "completion_status"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/semver" },
    "impact_report_id": { "type": "string", "pattern": "^IAR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "change_request_id": { "type": "string", "pattern": "^DCR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["draft", "blocked", "ready", "applied"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_artifact": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
    "impact_cone": { "$ref": "https://datacanvas.local/schemas/cascade-impact-cone.schema.json" },
    "affected_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/affectedArtifact" }
    },
    "blocking_user_decisions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DEC-[A-Z0-9-]+$" }
    },
    "derived_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact", "source_paths"],
        "additionalProperties": false,
        "properties": {
          "fact": { "type": "string", "minLength": 1 },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" }
          }
        }
      }
    },
    "assumptions_forbidden": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal", "classification"],
        "additionalProperties": false,
        "properties": {
          "proposal": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": [
              "derived_from_sources",
              "requires_user_confirmation",
              "blocked_missing_input",
              "not_applicable",
              "estimate_evidence",
              "semantic_product_change",
              "process_structure_change",
              "generated_refresh",
              "provenance_only",
              "mixed_or_ambiguous"
            ]
          }
        }
      }
    },
    "validation_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "blocked_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "edge_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "upstream_artifact",
          "downstream_artifact",
          "relation_type",
          "requires_user_confirmation",
          "blocking_decision_id"
        ],
        "additionalProperties": false,
        "properties": {
          "upstream_artifact": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "downstream_artifact": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "relation_type": {
            "type": "string",
            "enum": [
              "semantic",
              "traceability",
              "navigation",
              "resource",
              "jira",
              "evidence",
              "generated",
              "process",
              "source_provenance",
              "estimate_evidence",
              "approval",
              "registry_consistency",
              "xlsx_recovery"
            ]
          },
          "requires_user_confirmation": { "type": "boolean" },
          "blocking_decision_id": { "type": ["string", "null"], "pattern": "^DEC-[A-Z0-9-]+$" }
        }
      }
    },
    "completion_status": { "type": "string", "enum": ["blocked", "pending", "complete"] }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://" },
          { "pattern": "\\\\" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "affectedArtifact": {
      "type": "object",
      "required": ["path", "required_edits", "optional_edits", "update_status", "no_change_rationale"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
        "required_edits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "optional_edits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "update_status": {
          "type": "string",
          "enum": ["pending", "applied", "no_change_confirmed", "not_applicable", "blocked"]
        },
        "no_change_rationale": {
          "type": ["object", "null"],
          "required": [
            "rationale",
            "confirmed_by",
            "confirmed_at",
            "source_artifact",
            "change_class",
            "covered_requirements",
            "acceptance_impact",
            "traceability_impact",
            "residual_risk",
            "owner_role",
            "reconsider_when"
          ],
          "additionalProperties": false,
          "properties": {
            "rationale": { "type": "string", "minLength": 1 },
            "confirmed_by": { "type": "string", "minLength": 1 },
            "confirmed_at": { "type": "string", "format": "date-time" },
            "source_artifact": {
              "anyOf": [
                { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
                { "type": "null" }
              ]
            },
            "change_class": {
              "type": "string",
              "enum": [
                "estimate_evidence",
                "semantic_product_change",
                "source_provenance_change",
                "provenance_only",
                "registry_consistency_change",
                "generated_refresh",
                "process_structure_change",
                "mixed_or_ambiguous"
              ]
            },
            "covered_requirements": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "acceptance_impact": { "type": "string", "minLength": 1 },
            "traceability_impact": { "type": "string", "minLength": 1 },
            "residual_risk": { "type": "string", "minLength": 1 },
            "owner_role": { "type": "string", "minLength": 1 },
            "reconsider_when": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
