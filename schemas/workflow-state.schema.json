{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/workflow-state.schema.json",
  "title": "UniversalDocumentationWorkflowState",
  "type": "object",
  "required": [
    "$schema",
    "workflow_id",
    "workflow_version",
    "project_profile_id",
    "product_profile_id",
    "run_id",
    "status",
    "phase",
    "current_step",
    "scope",
    "artifact_catalog_path",
    "decision_queue_path",
    "event_log_path",
    "run_ledger_path",
    "validation_plan",
    "resume_token"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "workflow_id": { "type": "string", "const": "universal-documentation-workflow" },
    "workflow_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "project_profile_id": { "type": "string", "minLength": 1 },
    "product_profile_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^UDW-RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["initialized", "intake_validated", "inventory_completed", "methodology_checked", "impact_analyzed", "awaiting_decision", "approved_to_apply", "applying_changes", "generating", "validating", "blocked", "recovery_required", "completed", "abandoned"] },
    "phase": { "type": "string", "enum": ["intake", "inventory", "methodology_check", "impact_analysis", "decision_pass", "apply_pass", "generate_pass", "validate_pass", "index_pass", "completion_pass"] },
    "current_step": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["request_classification", "mode", "profile_scope", "change_instance_path"],
      "additionalProperties": false,
      "properties": {
        "request_classification": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["planning", "implementation", "validation", "recovery"] },
        "profile_scope": { "type": "string", "enum": ["universal", "pilot_specific", "project_specific"] },
        "change_instance_path": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_catalog_path": { "type": "string", "minLength": 1 },
    "decision_queue_path": { "type": "string", "minLength": 1 },
    "event_log_path": { "type": "string", "minLength": 1 },
    "run_ledger_path": { "type": "string", "minLength": 1 },
    "validation_plan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "resume_token": {
      "type": "object",
      "required": ["last_safe_step", "next_safe_step", "requires_owner_decision"],
      "additionalProperties": false,
      "properties": {
        "last_safe_step": { "type": "string", "minLength": 1 },
        "next_safe_step": { "type": "string", "minLength": 1 },
        "requires_owner_decision": { "type": "boolean" }
      }
    }
  }
}
