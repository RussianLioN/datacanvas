{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/tool-allowlist.schema.json",
  "title": "ToolAllowlist",
  "type": "object",
  "required": ["version", "status", "default_policy", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "default_policy": { "type": "string", "enum": ["deny"] },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purpose", "network_access", "write_access", "allowed_data_classes", "owner"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
          "purpose": { "type": "string", "minLength": 1 },
          "network_access": { "type": "boolean" },
          "write_access": { "type": "boolean" },
          "allowed_data_classes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["public", "internal", "confidential", "pii", "secret"] }
          },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
