{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/sa-spec.schema.json",
  "title": "SystemAnalysisSpec",
  "type": "object",
  "required": [
    "version",
    "status",
    "source_ba_spec_path",
    "srs_path",
    "requirements",
    "interfaces",
    "lifecycle_states",
    "errors",
    "nfrs"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "source_ba_spec_path": { "type": "string", "minLength": 1 },
    "srs_path": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "verification_method", "source_claim_ids"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^(BT|NFR)-[0-9]{3}(-DELTA)?$" },
          "verification_method": { "type": "string", "minLength": 1 },
          "source_claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^BASA-CLM-[0-9]{3}$" } }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["interface_id", "name", "trust_boundary", "input_schema", "validation_command"],
        "additionalProperties": false,
        "properties": {
          "interface_id": { "type": "string", "pattern": "^IF-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "trust_boundary": { "type": "string", "minLength": 1 },
          "input_schema": { "type": "string", "minLength": 1 },
          "validation_command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lifecycle_states": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["state_id", "name", "entry_condition", "exit_condition"],
        "additionalProperties": false,
        "properties": {
          "state_id": { "type": "string", "pattern": "^STATE-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "entry_condition": { "type": "string", "minLength": 1 },
          "exit_condition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "errors": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["error_id", "summary", "retry_policy", "rollback_signal", "redaction_rule"],
        "additionalProperties": false,
        "properties": {
          "error_id": { "type": "string", "pattern": "^ERR-[0-9]{3}$" },
          "summary": { "type": "string", "minLength": 1 },
          "retry_policy": { "type": "string", "minLength": 1 },
          "rollback_signal": { "type": "string", "minLength": 1 },
          "redaction_rule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nfrs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["nfr_id", "category", "fit_criterion", "validation_command"],
        "additionalProperties": false,
        "properties": {
          "nfr_id": { "type": "string", "pattern": "^NFR-[0-9]{3}$" },
          "category": { "type": "string", "minLength": 1 },
          "fit_criterion": { "type": "string", "minLength": 1 },
          "validation_command": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
