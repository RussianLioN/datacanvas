{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/release-evidence-pack.schema.json",
  "title": "ReleaseEvidencePack",
  "type": "object",
  "required": [
    "version",
    "release_id",
    "status",
    "gate_id",
    "release_goal",
    "accepted_prs",
    "commit_sha",
    "ci_evidence",
    "artifact_registry_snapshot",
    "known_risks",
    "rollback_forward_fix_plan",
    "acceptance_decision",
    "evidence_paths",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "release_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["release_candidate"] },
    "gate_id": { "type": "string", "const": "G9" },
    "release_goal": { "type": "string", "minLength": 1 },
    "accepted_prs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["not_applicable", "accepted"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commit_sha": {
      "type": "object",
      "required": ["status", "value", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending_until_commit", "captured"] },
        "value": { "type": "string" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "ci_evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["command", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_registry_snapshot": {
      "type": "object",
      "required": ["path", "hash_manifest_path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash_manifest_path": { "type": "string", "minLength": 1 }
      }
    },
    "known_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk_id", "status", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "risk_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "mitigation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback_forward_fix_plan": {
      "type": "object",
      "required": ["rollback", "forward_fix"],
      "additionalProperties": false,
      "properties": {
        "rollback": { "type": "string", "minLength": 1 },
        "forward_fix": { "type": "string", "minLength": 1 }
      }
    },
    "acceptance_decision": {
      "type": "object",
      "required": ["decision", "review_state", "source"],
      "additionalProperties": false,
      "properties": {
        "decision": { "type": "string", "enum": ["accepted_for_candidate"] },
        "review_state": { "type": "string", "enum": ["approved"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
