{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/pilot-execution-handoff.schema.json",
  "title": "PilotExecutionHandoff",
  "type": "object",
  "required": [
    "version",
    "status",
    "gate_id",
    "depends_on_gate_id",
    "purpose",
    "pilot_owner_role",
    "entry_criteria",
    "pilot_steps",
    "required_outputs",
    "validation_commands",
    "stop_conditions",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["ready_for_pilot_run_after_real_uat"] },
    "gate_id": { "type": "string", "const": "G10" },
    "depends_on_gate_id": { "type": "string", "const": "G9" },
    "purpose": { "type": "string", "minLength": 1 },
    "pilot_owner_role": { "type": "string", "minLength": 1 },
    "entry_criteria": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "description", "evidence_path", "required_status", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence_path": { "type": "string", "minLength": 1 },
          "required_status": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "pilot_steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "action", "expected_evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expected_evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "status_before_pilot", "status_after_pilot"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status_before_pilot": { "type": "string", "minLength": 1 },
          "status_after_pilot": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
