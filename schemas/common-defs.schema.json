{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/common-defs.schema.json",
  "title": "CommonDataCanvasSchemaDefinitions",
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://" },
          { "pattern": "\\\\" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "nullableRepoPath": {
      "anyOf": [
        { "$ref": "#/$defs/repoPath" },
        { "type": "null" }
      ]
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "cascadeChangeClass": {
      "type": "string",
      "enum": [
        "acceptance_meaning",
        "business_model",
        "business_requirement",
        "capacity",
        "change_order",
        "documentation",
        "estimate_change",
        "formatting_change",
        "formatting_only",
        "formula_cache_only",
        "hypothesis",
        "mixed_or_ambiguous",
        "no_change",
        "non_functional_requirement",
        "priority_change",
        "product_goal",
        "product_meaning",
        "provenance_only",
        "roadmap_meaning",
        "row_add_remove",
        "scope_change",
        "source_identity",
        "story_text_change"
      ]
    },
    "quarter": {
      "type": "string",
      "pattern": "^[0-9]{4}-Q[1-4]$"
    },
    "nullableQuarter": {
      "anyOf": [
        { "$ref": "#/$defs/quarter" },
        { "type": "null" }
      ]
    }
  }
}
