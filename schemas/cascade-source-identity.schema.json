{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-source-identity.schema.json",
  "title": "Cascade source identity v1",
  "type": "object",
  "required": ["$schema", "version", "identity_set_id", "registry_path", "registry_sha256", "trigger_sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-source-identity.schema.json" },
    "version": { "const": "1.0.0" },
    "identity_set_id": { "type": "string", "pattern": "^CSI-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "registry_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
    "registry_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "registry_delta": {
      "type": ["object", "null"],
      "required": ["delta_id", "before_sha256", "after_sha256", "source_selectors"],
      "additionalProperties": false,
      "properties": {
        "delta_id": { "type": "string", "pattern": "^PSR-DELTA-[A-Z0-9-]+$" },
        "before_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
        "after_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
        "source_selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "operation"],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
              "operation": { "enum": ["add", "remove", "rename", "update"] }
            }
          }
        }
      }
    },
    "trigger_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trigger_path", "source_kind", "source_id", "source_path", "provenance_path", "resolution"],
        "additionalProperties": false,
        "properties": {
          "trigger_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "source_kind": { "enum": ["product_document", "xlsx", "provenance", "source_registry", "generated", "process"] },
          "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "source_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
          "provenance_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/nullableRepoPath" },
          "resolution": { "enum": ["explicit", "deterministic_registry_match", "registry_delta", "change_request"] }
        }
      }
    }
  }
}
