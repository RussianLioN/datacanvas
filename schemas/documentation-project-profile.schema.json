{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/documentation-project-profile.schema.json",
  "title": "DocumentationProjectProfile",
  "type": "object",
  "required": [
    "project_profile_id",
    "name",
    "repository_role",
    "documentation_domain",
    "owners",
    "routes",
    "language_rules",
    "validation_command_catalog_path",
    "security_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "project_profile_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "repository_role": { "type": "string", "enum": ["documentation_repository"] },
    "documentation_domain": { "type": "string", "const": "documentation_operations" },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "responsibility"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "responsibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routes": {
      "type": "object",
      "required": ["navigation_source", "artifact_registry", "hash_manifest", "leakage_manifest"],
      "additionalProperties": false,
      "properties": {
        "navigation_source": { "type": "string", "minLength": 1 },
        "artifact_registry": { "type": "string", "minLength": 1 },
        "hash_manifest": { "type": "string", "minLength": 1 },
        "leakage_manifest": { "type": "string", "minLength": 1 }
      }
    },
    "language_rules": {
      "type": "object",
      "required": ["human_readable_artifacts", "technical_identifiers_preserved"],
      "additionalProperties": false,
      "properties": {
        "human_readable_artifacts": { "type": "string", "minLength": 2 },
        "technical_identifiers_preserved": { "type": "boolean" }
      }
    },
    "validation_command_catalog_path": { "type": "string", "minLength": 1 },
    "security_boundary": {
      "type": "object",
      "required": ["default_unknown_data_class", "public_navigation_for_confidential", "network_boundary_change_requires_decision"],
      "additionalProperties": false,
      "properties": {
        "default_unknown_data_class": { "type": "string", "enum": ["internal", "confidential", "sensitive"] },
        "public_navigation_for_confidential": { "type": "string", "enum": ["metadata_only", "blocked"] },
        "network_boundary_change_requires_decision": { "type": "boolean" }
      }
    }
  }
}
