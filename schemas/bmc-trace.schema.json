{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/bmc-trace.schema.json",
  "title": "BmcTrace",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "language",
    "status",
    "source_lock_path",
    "interview_result_paths",
    "derived_manifest_path",
    "blocks",
    "items",
    "claims",
    "hypotheses",
    "open_questions",
    "unsupported_claims",
    "evidence_requests",
    "derived_artifacts",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["ru"] },
    "status": { "type": "string", "enum": ["draft_interview_ready", "draft_interviewed", "draft_working", "accepted"] },
    "source_lock_path": { "type": "string", "minLength": 1 },
    "interview_result_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "derived_manifest_path": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "title", "public_title", "short_title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9"] },
          "title": { "type": "string", "minLength": 1 },
          "public_title": { "type": "string", "minLength": 1 },
          "short_title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "block",
          "statement",
          "bullets",
          "detail",
          "status",
          "confidence",
          "owner_role",
          "source_refs",
          "interview_answer_ids",
          "evidence_ids",
          "brainstorm_result_ids",
          "hypothesis_ids",
          "requirement_ids",
          "backlog_item_ids",
          "risk_ids",
          "last_reviewed_at"
        ],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^BMC-CLM-\\d{3}$" },
          "block": { "type": "string", "enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9"] },
          "statement": { "type": "string", "minLength": 1 },
          "bullets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 }
          },
          "detail": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "type": "string", "enum": ["confirmed", "unconfirmed", "assumption", "unsupported", "contradicted", "deprecated"] },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "owner_role": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "interview_answer_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ANS-\\d{3}$" }
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EVD-" }
          },
          "brainstorm_result_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^BMC-INT-" }
          },
          "hypothesis_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^HYP-" }
          },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "backlog_item_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "risk_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "last_reviewed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "item_id",
          "source_refs",
          "derivation",
          "introduced_in",
          "validation_state",
          "public_inclusion_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string", "pattern": "^BMC-CLM-\\d{3}$" },
          "item_id": { "type": "string", "pattern": "^BMC-CLM-\\d{3}$" },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "derivation": { "type": "string", "minLength": 1 },
          "introduced_in": { "type": "string", "minLength": 1 },
          "validation_state": { "type": "string", "enum": ["confirmed", "unconfirmed", "assumption", "unsupported", "contradicted", "deprecated"] },
          "public_inclusion_policy": { "type": "string", "enum": ["include_clean_statement_only", "exclude_until_confirmed"] }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "statement", "status"],
        "additionalProperties": false,
        "properties": {
          "hypothesis_id": { "type": "string", "pattern": "^HYP-" },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["confirmed", "unconfirmed", "assumption", "rejected"] }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^BMC-OQ-\\d{3}$" }
    },
    "unsupported_claims": {
      "type": "array",
      "items": { "type": "string", "pattern": "^BMC-CLM-\\d{3}$" }
    },
    "evidence_requests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVD-REQ-\\d{3}$" }
    },
    "derived_artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "format", "generated_by"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["markdown", "plantuml", "svg", "png", "pdf", "validation_needs_json"] },
          "generated_by": { "type": "string", "minLength": 1 }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["prepared_by", "prepared_at", "real_user_interview_completed", "next_safe_step"],
      "additionalProperties": false,
      "properties": {
        "prepared_by": { "type": "string", "minLength": 1 },
        "prepared_at": { "type": "string", "format": "date-time" },
        "real_user_interview_completed": { "type": "boolean" },
        "next_safe_step": { "type": "string", "minLength": 1 }
      }
    }
  }
}
