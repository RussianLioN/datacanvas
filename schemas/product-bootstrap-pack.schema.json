{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/product-bootstrap-pack.schema.json",
  "title": "ProductBootstrapPack",
  "type": "object",
  "required": ["$schema", "version", "status", "pack_id", "required_artifacts", "bootstrap_validation_commands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "template_ready", "accepted"] },
    "pack_id": { "type": "string", "minLength": 1 },
    "required_artifacts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["artifact_kind", "description"],
        "additionalProperties": false,
        "properties": {
          "artifact_kind": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bootstrap_validation_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
