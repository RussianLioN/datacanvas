{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/threat-model-delta-manifest.schema.json",
  "title": "ThreatModelDeltaManifest",
  "type": "object",
  "required": ["version", "status", "source_plan", "baseline_threat_model_path", "policy", "coverage", "known_limitations", "next_safe_step"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["active"] },
    "source_plan": { "type": "string" },
    "baseline_threat_model_path": { "type": "string" },
    "policy": {
      "type": "object",
      "required": ["require_entry_for_every_sprint", "allowed_delta_statuses", "forward_rule"],
      "additionalProperties": false,
      "properties": {
        "require_entry_for_every_sprint": { "type": "boolean", "const": true },
        "allowed_delta_statuses": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "enum": ["delta_recorded", "no_security_impact", "requires_review"] }
        },
        "forward_rule": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sprint_path", "sprint_id", "delta_status", "security_impact", "evidence_paths", "rationale", "owner_role"],
        "additionalProperties": false,
        "properties": {
          "sprint_path": { "type": "string", "minLength": 1 },
          "sprint_id": { "type": "string", "minLength": 1 },
          "delta_status": { "type": "string", "enum": ["delta_recorded", "no_security_impact", "requires_review"] },
          "security_impact": { "type": "string", "enum": ["none", "low", "medium", "high"] },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
