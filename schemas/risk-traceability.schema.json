{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/risk-traceability.schema.json",
  "title": "RiskTraceability",
  "type": "object",
  "required": ["version", "links"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk_id", "nfr_ids", "traceability_requirement_ids", "eval_case_ids", "evidence_paths"],
        "additionalProperties": false,
        "properties": {
          "risk_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "nfr_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^NFR-[0-9]+$" }
          },
          "traceability_requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(BT|NFR|REQ)-[0-9]+$" }
          },
          "eval_case_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^EVAL-[0-9]+$" }
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
