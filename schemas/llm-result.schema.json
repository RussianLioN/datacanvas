{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/llm-result.schema.json",
  "title": "LLMResult",
  "type": "object",
  "required": ["result_id", "schema_version", "status"],
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^LLMRES-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "presentation_spec": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": ["insufficient_data", "schema_violation", "security_violation", "model_error"]
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "presentation_spec": {
          "type": "object"
        }
      },
      "required": ["presentation_spec"]
    },
    {
      "properties": {
        "error": {
          "type": "object"
        }
      },
      "required": ["error"]
    }
  ]
}
