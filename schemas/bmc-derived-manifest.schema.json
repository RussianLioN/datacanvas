{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/bmc-derived-manifest.schema.json",
  "title": "BmcDerivedManifest",
  "type": "object",
  "required": ["version", "status", "source_trace_path", "source_trace_sha256", "generated_by", "generated_at", "outputs"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["generated"] },
    "source_trace_path": { "type": "string", "minLength": 1 },
    "source_trace_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "outputs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["format", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "format": { "type": "string", "enum": ["markdown", "plantuml", "svg", "png", "pdf", "validation_needs_json"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
