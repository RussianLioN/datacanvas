{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/schema-coverage-registry.schema.json",
  "title": "SchemaCoverageRegistry",
  "type": "object",
  "required": ["$schema", "version", "status", "registry_id", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "accepted"] },
    "registry_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity",
          "schema_path",
          "data_path",
          "positive_fixture_path",
          "negative_fixture_path",
          "negative_scenario_ids",
          "negative_rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "schema_path": { "type": "string", "minLength": 1 },
          "data_path": { "type": "string", "minLength": 1 },
          "positive_fixture_path": { "type": "string", "minLength": 1 },
          "negative_fixture_path": { "type": ["string", "null"] },
          "negative_scenario_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "negative_rationale": { "type": ["string", "null"] }
        }
      }
    }
  }
}
