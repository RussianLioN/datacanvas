{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/backlog-registry.schema.json",
  "title": "BacklogRegistry",
  "type": "object",
  "required": ["version", "status", "contours"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["active", "draft"] },
    "contours": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name", "source_path", "owner_role", "item_prefixes", "required_for_sprint_planning"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "item_prefixes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]+-$" }
          },
          "required_for_sprint_planning": { "type": "boolean" }
        }
      }
    }
  }
}
