{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/revision-approval-state.schema.json",
  "title": "RevisionApprovalState",
  "type": "object",
  "required": [
    "version",
    "revision_id",
    "status",
    "mode",
    "owner_role",
    "change_order_id",
    "change_set_path",
    "log_path",
    "ledger_path",
    "source_registry_path",
    "started_at",
    "updated_at",
    "paused_at",
    "completed_at",
    "current_edit",
    "save_policy",
    "validation_policy",
    "edit_statuses",
    "resume_instructions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "revision_id": { "type": "string", "pattern": "^REV-[A-Z0-9-]+$" },
    "status": { "type": "string", "enum": ["not_started", "in_progress", "paused", "completed", "abandoned"] },
    "mode": { "type": "string", "enum": ["source_document_revision_approval"] },
    "owner_role": { "type": "string", "minLength": 1 },
    "change_order_id": { "type": "string", "pattern": "^CO-[0-9]{4}-[0-9]{3}$" },
    "change_set_path": { "$ref": "#/$defs/repoPath" },
    "log_path": { "$ref": "#/$defs/repoPath" },
    "ledger_path": { "$ref": "#/$defs/repoPath" },
    "source_registry_path": { "$ref": "#/$defs/repoPath" },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "paused_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "current_edit": {
      "type": "object",
      "required": ["edit_id", "title", "state", "next_action"],
      "additionalProperties": false,
      "properties": {
        "edit_id": { "type": "string", "pattern": "^EDIT-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "enum": ["next", "blocked", "not_applicable"] },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "save_policy": {
      "type": "object",
      "required": ["save_after_each_answer", "pause_every_answers", "resume_from_state_required", "show_existing_section_before_question"],
      "additionalProperties": false,
      "properties": {
        "save_after_each_answer": { "type": "boolean", "const": true },
        "pause_every_answers": { "type": "integer", "minimum": 1 },
        "resume_from_state_required": { "type": "boolean", "const": true },
        "show_existing_section_before_question": { "type": "boolean", "const": true }
      }
    },
    "validation_policy": {
      "type": "object",
      "required": ["light_validation_command", "final_validation_rule", "final_validation_commands"],
      "additionalProperties": false,
      "properties": {
        "light_validation_command": { "type": "string", "minLength": 1 },
        "final_validation_rule": { "type": "string", "minLength": 1 },
        "final_validation_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edit_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edit_id", "status", "blocking"],
        "additionalProperties": false,
        "properties": {
          "edit_id": { "type": "string", "pattern": "^EDIT-[0-9]{3}$" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected", "edited", "applied", "skipped", "not_required"] },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "resume_instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    }
  }
}
