{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/eval-case.schema.json",
  "title": "EvalCaseSet",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["happy_path", "negative", "security", "traceability", "presentation_quality", "hallucination_resistance"]
          },
          "description": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    }
  }
}
