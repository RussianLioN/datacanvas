{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/generator-contracts.schema.json",
  "title": "GeneratorContracts",
  "type": "object",
  "required": ["$schema", "version", "status", "contract_catalog_id", "contracts", "topological_order"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "accepted"] },
    "contract_catalog_id": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "generator_id",
          "owner_role",
          "inputs",
          "outputs",
          "allowed_writes",
          "generate_command",
          "check_command",
          "deterministic_environment",
          "dependencies",
          "post_validators",
          "failure_modes"
        ],
        "additionalProperties": false,
        "properties": {
          "generator_id": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "allowed_writes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "generate_command": { "type": "string", "minLength": 1 },
          "check_command": { "type": "string", "minLength": 1 },
          "deterministic_environment": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "post_validators": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "failure_modes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "topological_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
