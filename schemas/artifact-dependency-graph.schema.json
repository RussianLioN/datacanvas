{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/artifact-dependency-graph.schema.json",
  "title": "ArtifactDependencyGraph",
  "type": "object",
  "required": ["version", "status", "graph_id", "artifacts", "declared_cycle_groups", "dependencies", "high_impact_sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/semver" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "graph_id": { "type": "string", "pattern": "^ADG-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "declared_cycle_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/declaredCycleGroup" }
    },
    "high_impact_sources": {
      "type": "array",
      "items": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "layer": {
      "type": "string",
      "enum": [
        "Vision",
        "BMC",
        "Product Goal",
        "hypotheses",
        "stories",
        "business requirements",
        "NFR",
        "acceptance criteria",
        "product backlog",
        "analysis source",
        "working backlog",
        "provenance manifest",
        "source registry",
        "evidence index",
        "resource estimation",
        "technical/eval/process backlog",
        "roadmap",
        "capacity plan",
        "sprint artifacts",
        "release evidence",
        "Jira import package",
        "traceability",
        "navigation",
        "process"
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "path", "layer", "owner_role", "validation_command", "authority_scope"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^DGA-[0-9]{3}$" },
        "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
        "layer": { "$ref": "#/$defs/layer" },
        "owner_role": { "type": "string", "minLength": 1 },
        "validation_command": { "type": "string", "minLength": 1 },
        "authority_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityScope" }
        }
      }
    },
    "authorityScope": {
      "type": "string",
      "enum": [
        "acceptance_meaning",
        "business_model",
        "business_requirement",
        "capacity",
        "change_order",
        "effort_estimate",
        "hypothesis",
        "non_functional_requirement",
        "priority_change",
        "product_goal",
        "product_meaning",
        "provenance",
        "roadmap_meaning",
        "scope_change",
        "source_data",
        "source_identity",
        "story_text_change"
      ]
    },
    "declaredCycleGroup": {
      "type": "object",
      "required": ["cycle_id", "member_paths", "purpose", "rationale", "owner_role"],
      "additionalProperties": false,
      "properties": {
        "cycle_id": { "type": "string", "pattern": "^CYCLE-[A-Z0-9-]+$" },
        "member_paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" }
        },
        "purpose": { "type": "string", "const": "reconciliation" },
        "rationale": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "edge_id",
        "upstream_artifact",
        "downstream_artifact",
        "relation_type",
        "update_rule",
        "validation_command",
        "owner_role",
        "user_confirmation_required",
        "resolution_required",
        "applicable_change_classes"
      ],
      "additionalProperties": false,
      "properties": {
        "edge_id": { "type": "string", "pattern": "^EDGE-[0-9]{4}$" },
        "applicable_change_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "*",
              "acceptance_meaning",
              "business_model",
              "business_requirement",
              "capacity",
              "change_order",
              "documentation",
              "estimate_change",
              "formatting_change",
              "formatting_only",
              "formula_cache_only",
              "mixed_or_ambiguous",
              "non_functional_requirement",
              "no_change",
              "priority_change",
              "product_goal",
              "product_meaning",
              "provenance_only",
              "row_add_remove",
              "roadmap_meaning",
              "scope_change",
              "source_identity",
              "hypothesis",
              "story_text_change"
            ]
          }
        },
        "upstream_artifact": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
        "downstream_artifact": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
        "relation_type": {
          "type": "string",
          "enum": [
            "semantic",
            "traceability",
            "navigation",
            "resource",
            "jira",
            "evidence",
            "generated",
            "process",
            "source_provenance",
            "estimate_evidence",
            "approval",
            "registry_consistency",
            "xlsx_recovery"
          ]
        },
        "update_rule": { "type": "string", "minLength": 1 },
        "validation_command": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
	        "user_confirmation_required": {
	          "type": "string",
	          "enum": ["never", "semantic_change", "always", "when_capacity_or_priority_changes", "when_jira_mapping_changes"]
	        },
	        "resolution_required": {
	          "type": "string",
	          "enum": ["none", "changed_or_no_change_rationale"]
	        }
      }
    }
  }
}
