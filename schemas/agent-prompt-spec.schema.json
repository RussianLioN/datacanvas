{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/agent-prompt-spec.schema.json",
  "title": "AgentPromptSpec",
  "type": "object",
  "required": [
    "version",
    "prompt_id",
    "status",
    "task_id",
    "safe_context",
    "goal",
    "constraints",
    "validation_commands",
    "forbidden_inputs",
    "forbidden_behaviors",
    "raw_transcript_included"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "prompt_id": { "type": "string", "pattern": "^APS-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["draft", "ready"] },
    "task_id": { "type": "string", "pattern": "^TSK-[0-9]{3}$" },
    "safe_context": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validation_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "forbidden_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "forbidden_behaviors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "raw_transcript_included": { "type": "boolean", "const": false },
    "traceability_refs": { "$ref": "#/$defs/traceability_refs" }
  },
  "$defs": {
    "traceability_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^CO3-DEC-[0-9]{3}$" } },
        "change_order_ids": { "type": "array", "items": { "type": "string", "pattern": "^CO-[0-9]{4}-[0-9]{3}$" } },
        "story_ids": { "type": "array", "items": { "type": "string", "pattern": "^DC-ST-[0-9]{2,3}$" } },
        "acceptance_scenario_ids": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "interface_ids": { "type": "array", "items": { "type": "string", "pattern": "^IF-[0-9]{3}$" } },
        "business_rule_ids": { "type": "array", "items": { "type": "string", "pattern": "^BRULE-[0-9]{3}$" } }
      }
    }
  }
}
