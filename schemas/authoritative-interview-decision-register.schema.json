{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/authoritative-interview-decision-register.schema.json",
  "title": "AuthoritativeInterviewDecisionRegister",
  "type": "object",
  "required": ["version", "change_order_id", "source_of_truth_policy", "decisions", "verbatim_wordings", "authoritative_messages", "post_interview_amendments", "visual_release_gate", "unresolved_authoritative_text_ids"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "change_order_id": {"const": "CO-2026-003"},
    "source_of_truth_policy": {
      "type": "object",
      "required": ["interview_precedence", "controlled_xlsx_path", "curated_register_path", "raw_data_policy"],
      "additionalProperties": false,
      "properties": {
        "interview_precedence": {"const": "equal_to_controlled_xlsx"},
        "controlled_xlsx_path": {"type": "string", "minLength": 1},
        "curated_register_path": {"type": "string", "minLength": 1},
        "raw_data_policy": {"const": "forbid_sensitive_raw_data_allow_curated_authoritative_register"}
      }
    },
    "decisions": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/decision"}},
    "verbatim_wordings": {"type": "array", "minItems": 24, "items": {"$ref": "#/$defs/wording"}},
    "authoritative_messages": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/message"}},
    "post_interview_amendments": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/post_interview_amendment"}},
    "visual_release_gate": {"$ref": "#/$defs/visual_release_gate"},
    "unresolved_authoritative_text_ids": {"type": "array", "items": {"type": "string", "pattern": "^CO3-MSG-\\d{3}$"}}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["decision_id", "question_id", "authoritative_wording_id", "status"],
      "additionalProperties": false,
      "properties": {
        "decision_id": {"type": "string", "pattern": "^CO3-DEC-\\d{3}$"},
        "question_id": {"type": "string", "pattern": "^Q4-\\d{2}$"},
        "authoritative_wording_id": {"type": "string", "pattern": "^CO3-WRD-\\d{3}$"},
        "status": {"enum": ["confirmed", "deferred"]}
      }
    },
    "wording": {
      "type": "object",
      "required": ["wording_id", "decision_id", "source", "text"],
      "additionalProperties": false,
      "properties": {
        "wording_id": {"type": "string", "pattern": "^CO3-WRD-\\d{3}$"},
        "decision_id": {"type": "string", "pattern": "^CO3-DEC-\\d{3}$"},
        "source": {"enum": ["questionnaire_state_answer", "questionnaire_state_decision", "questionnaire_log"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "message": {
      "type": "object",
      "required": ["message_id", "lifecycle_message_id", "text"],
      "additionalProperties": false,
      "properties": {
        "message_id": {"type": "string", "pattern": "^CO3-MSG-\\d{3}$"},
        "lifecycle_message_id": {"enum": ["order_started", "order_not_accepted", "delivery_confirmed", "delivery_delayed", "delivery_partial"]},
        "text": {"type": "string", "minLength": 1},
        "contour_display_rule": {"const": "by_actual_address_lookup"}
      },
      "allOf": [
        {
          "if": {"properties": {"lifecycle_message_id": {"const": "delivery_partial"}}, "required": ["lifecycle_message_id"]},
          "then": {"properties": {"contour_display_rule": {"const": "by_actual_address_lookup"}}, "required": ["contour_display_rule"]}
        }
      ]
    },
    "post_interview_amendment": {
      "oneOf": [
        {"$ref": "#/$defs/delivery_formats_amendment"},
        {"$ref": "#/$defs/isolated_draft_amendment"},
        {"$ref": "#/$defs/final_visual_release_amendment"}
      ]
    },
    "delivery_formats_amendment": {
      "type": "object",
      "required": ["amendment_id", "recorded_at", "source", "supersedes", "delivery_formats", "affected_artifacts"],
      "additionalProperties": false,
      "properties": {
        "amendment_id": {"const": "CO3-AMND-001"},
        "recorded_at": {"type": "string", "format": "date"},
        "source": {"const": "owner_follow_up_confirmation"},
        "supersedes": {
          "type": "object",
          "required": ["decision_id", "scope"],
          "additionalProperties": false,
          "properties": {
            "decision_id": {"const": "CO3-DEC-001"},
            "scope": {"const": "delivery_formats_only"}
          }
        },
        "delivery_formats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"enum": ["PPTX", "PDF"]}
        },
        "affected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "isolated_draft_amendment": {
      "type": "object",
      "required": ["amendment_id", "recorded_at", "source", "supersedes", "accepted_scope", "active_release_switch_allowed", "next_gate", "affected_artifacts"],
      "additionalProperties": false,
      "properties": {
        "amendment_id": {"const": "CO3-AMND-002"},
        "recorded_at": {"type": "string", "format": "date"},
        "source": {"const": "owner_follow_up_confirmation"},
        "supersedes": {
          "type": "object",
          "required": ["decision_id", "scope"],
          "additionalProperties": false,
          "properties": {
            "decision_id": {"const": "CO3-DEC-010"},
            "scope": {"const": "active_visual_release_only"}
          }
        },
        "accepted_scope": {"const": "isolated_draft_only"},
        "active_release_switch_allowed": {"const": false},
        "next_gate": {"const": "documentation_cascade_then_explicit_final_owner_approval"},
        "affected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "final_visual_release_amendment": {
      "type": "object",
      "required": ["amendment_id", "recorded_at", "source", "supersedes", "visual_release_status", "active_release_switch_allowed", "high_resolution_render_allowed", "delivery_archive_allowed", "current_release_ledger_path", "preserves_historical_snapshot", "affected_artifacts"],
      "additionalProperties": false,
      "properties": {
        "amendment_id": {"const": "CO3-AMND-003"},
        "recorded_at": {"const": "2026-09-03"},
        "source": {"const": "owner_final_visual_release_acceptance"},
        "supersedes": {
          "type": "object",
          "required": ["amendment_id", "scope"],
          "additionalProperties": false,
          "properties": {
            "amendment_id": {"const": "CO3-AMND-002"},
            "scope": {"const": "final_visual_release_and_delivery_archive_only"}
          }
        },
        "visual_release_status": {"const": "owner_final_approved"},
        "active_release_switch_allowed": {"const": true},
        "high_resolution_render_allowed": {"const": true},
        "delivery_archive_allowed": {"const": true},
        "current_release_ledger_path": {"const": "docs/product/change-orders/co-2026-003-release-approval-ledger.json"},
        "preserves_historical_snapshot": {"const": true},
        "affected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "visual_release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_review_status", "visual_release_status", "release_condition"],
      "properties": {
        "content_review_status": {"enum": ["pending_product_owner", "approved_product_owner"]},
        "visual_release_status": {"enum": ["pending_product_owner", "approved_product_owner"]},
        "release_condition": {"const": "explicit_product_owner_visual_approval"}
      }
    }
  }
}
