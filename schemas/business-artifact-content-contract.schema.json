{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/business-artifact-content-contract.schema.json",
  "title": "DataCanvas business artifact content contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "contract_id",
    "documents",
    "artifact_classes",
    "global_forbidden_patterns"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "deprecated"]
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "class_name", "breadcrumb_required"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "breadcrumb_required": {
            "type": "boolean"
          },
          "lock_path": {
            "type": "string",
            "minLength": 1
          },
          "semantic_family": {
            "type": "string",
            "minLength": 1
          },
          "artifact_role": {
            "type": "string",
            "enum": ["canonical", "redirect", "derived", "historical_snapshot", "generated", "evidence", "index", "process_guardrail"]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifact_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_name", "purpose", "business_scope"],
        "properties": {
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "business_scope": {
            "type": "string",
            "minLength": 1
          },
          "allowed_h2": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_h2": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_h2": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_table_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_table_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "immutable_table_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_business_terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "terms", "required_context_pattern", "rationale"],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "terms": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required_context_pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "global_forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "message"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
