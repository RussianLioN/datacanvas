{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/process-event-log.schema.json",
  "title": "ProcessEventLog",
  "type": "object",
  "required": [
    "version",
    "status",
    "period",
    "purpose",
    "event_types",
    "events",
    "derived_metric_unlocks",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["ready_for_live_events", "active"] },
    "period": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "event_types": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "name", "required_for_metrics"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "required_for_metrics": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type_id", "timestamp", "actor_role", "artifact_path", "description"],
        "additionalProperties": false,
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "event_type_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" },
          "actor_role": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "derived_metric_unlocks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["metric_id", "required_event_type_ids", "status"],
        "additionalProperties": false,
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "required_event_type_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "type": "string", "enum": ["pending_events", "ready_to_measure"] }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
