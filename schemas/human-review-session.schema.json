{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/human-review-session.schema.json",
  "title": "HumanReviewSession",
  "type": "object",
  "required": ["version", "session_id", "status", "gate_id", "session_kind", "review_flow_path", "uat_manifest_path", "uat_result_path", "review_state", "decision", "actor", "audit_events", "evidence_paths", "known_limitations", "next_safe_step"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "session_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["recorded_fixture", "template", "recorded_real_user"] },
    "gate_id": { "type": "string", "const": "G9" },
    "session_kind": { "type": "string", "enum": ["fixture", "real_user"] },
    "review_flow_path": { "type": "string", "minLength": 1 },
    "uat_manifest_path": { "type": "string", "minLength": 1 },
    "uat_result_path": { "type": "string", "minLength": 1 },
    "review_state": { "type": "string", "enum": ["approved", "changes_requested", "rejected"] },
    "decision": { "type": "string", "enum": ["accepted", "blocked", "rejected"] },
    "actor": {
      "type": "object",
      "required": ["actor_id", "role"],
      "additionalProperties": false,
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "audit_events": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["actor_id", "role", "action", "source_artifact_id", "changed_claim_ids", "reason", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "actor_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "source_artifact_id": { "type": "string", "minLength": 1 },
          "changed_claim_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
