{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/business-artifact-generation-contract.schema.json",
  "title": "DataCanvas business artifact generation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "status",
    "contract_id",
    "source_content_contract",
    "backlog_parent_todo_id",
    "blocking_policy",
    "global_generation_rules",
    "enforced_forbidden_categories",
    "documents"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "deprecated"]
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "source_content_contract": {
      "type": "string",
      "minLength": 1
    },
    "backlog_parent_todo_id": {
      "type": "string",
      "pattern": "^PROC-\\d{3}$"
    },
    "blocking_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "todo_backlog_path",
        "required_before_document_cleanup",
        "required_before_validator_rollout",
        "stop_if_missing_contract",
        "scope"
      ],
      "properties": {
        "todo_backlog_path": {
          "type": "string",
          "minLength": 1
        },
        "required_before_document_cleanup": {
          "type": "boolean"
        },
        "required_before_validator_rollout": {
          "type": "boolean"
        },
        "stop_if_missing_contract": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "global_generation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enforced_forbidden_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "service_status",
          "local_path",
          "hash",
          "validation_command",
          "raw_json",
          "technical_contract",
          "source_mechanics",
          "sensitive_evidence",
          "generated_metadata",
          "service_rationale",
          "effort_estimation"
        ]
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "class_name",
          "blocking_todo_id",
          "generation_mode",
          "owner_role",
          "allowed_sections",
          "required_business_elements",
          "forbidden_content",
          "validator_requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "blocking_todo_id": {
            "type": "string",
            "pattern": "^PROC-\\d{3}$"
          },
          "generation_mode": {
            "type": "string",
            "enum": ["manual_agent_template", "generated_export", "working_export"]
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "allowed_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_business_elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validator_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
