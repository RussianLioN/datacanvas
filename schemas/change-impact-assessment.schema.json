{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/change-impact-assessment.schema.json",
  "title": "ChangeImpactAssessment",
  "type": "object",
  "required": [
    "version",
    "status",
    "change_order_id",
    "summary",
    "priority_before",
    "priority_after",
    "affected_users",
    "affected_artifacts",
    "affected_requirements",
    "affected_ports_adapters",
    "trust_boundary_delta",
    "sprint_goal_impact",
    "rollback",
    "validation_plan"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "accepted"] },
    "change_order_id": { "type": "string", "pattern": "^CO-[0-9]{4}-[0-9]{3}$" },
    "summary": { "type": "string", "minLength": 1 },
    "priority_before": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "priority_after": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_users": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(BT|NFR)-[0-9]{3}$" } },
    "affected_ports_adapters": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "trust_boundary_delta": { "type": "string", "minLength": 1 },
    "sprint_goal_impact": { "type": "string", "minLength": 1 },
    "rollback": { "type": "string", "minLength": 1 },
    "validation_plan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
