{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/cascading-update-run.schema.json",
  "title": "CascadingUpdateRun",
  "type": "object",
  "required": [
    "version",
    "run_id",
    "status",
    "change_request_path",
    "dependency_graph_path",
    "impact_report_path",
    "decision_queue_path",
    "capacity_plan_path",
    "reprioritization_report_path",
    "jira_mapping_request_path",
    "changed_artifacts",
    "skipped_artifacts",
    "generated_artifacts",
    "validation_results",
    "evidence_paths",
    "completion_claim"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "run_id": { "type": "string", "pattern": "^CUR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["planned", "blocked", "applied", "validated", "complete"] },
    "change_request_path": { "$ref": "#/$defs/repoPath" },
    "dependency_graph_path": { "$ref": "#/$defs/repoPath" },
    "impact_report_path": { "$ref": "#/$defs/repoPath" },
    "decision_queue_path": { "$ref": "#/$defs/repoPath" },
    "capacity_plan_path": { "anyOf": [{ "$ref": "#/$defs/repoPath" }, { "type": "null" }] },
    "reprioritization_report_path": { "anyOf": [{ "$ref": "#/$defs/repoPath" }, { "type": "null" }] },
    "jira_mapping_request_path": { "anyOf": [{ "$ref": "#/$defs/repoPath" }, { "type": "null" }] },
    "changed_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/changedArtifact" }
    },
    "skipped_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/skippedArtifact" }
    },
    "generated_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/generatedArtifact" }
    },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validationResult" }
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "completion_claim": {
      "type": "object",
      "required": ["done_claimed", "decision_queue_status", "all_affected_artifacts_resolved"],
      "additionalProperties": false,
      "properties": {
        "done_claimed": { "type": "boolean" },
        "decision_queue_status": { "type": "string", "enum": ["open", "blocked", "closed"] },
        "all_affected_artifacts_resolved": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "changedArtifact": {
      "type": "object",
      "required": ["path", "change_type", "confirmation_status"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "change_type": {
          "type": "string",
          "enum": ["semantic", "traceability", "navigation", "schema", "validator", "evidence", "process", "generated"]
        },
        "confirmation_status": { "type": "string", "enum": ["not_required", "confirmed", "pending"] }
      }
    },
    "skippedArtifact": {
      "type": "object",
      "required": ["path", "no_change_rationale", "confirmation_status"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "no_change_rationale": { "type": "string", "minLength": 1 },
        "confirmation_status": { "type": "string", "enum": ["confirmed", "pending"] }
      }
    },
    "generatedArtifact": {
      "type": "object",
      "required": ["path", "generator_command"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "generator_command": { "type": "string", "minLength": 1 }
      }
    },
    "validationResult": {
      "type": "object",
      "required": ["command", "status", "evidence", "ran_at"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
        "evidence": { "type": "string", "minLength": 1 },
        "ran_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
