{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-resolution-report.schema.json",
  "title": "Cascade resolution report v1",
  "type": "object",
  "required": ["$schema", "version", "resolution_id", "source_run_path", "candidate_head_sha", "source_resolutions", "artifact_resolutions", "acceptance_paths", "resolved_at", "resolution_sha256"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-resolution-report.schema.json" },
    "version": { "const": "1.0.0" },
    "resolution_id": { "type": "string", "pattern": "^CRI-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "source_run_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
    "candidate_head_sha": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/gitSha" },
    "source_resolutions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resolution" } },
    "artifact_resolutions": { "type": "array", "items": { "$ref": "#/$defs/resolution" } },
    "acceptance_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" } },
    "resolved_at": { "type": "string", "format": "date-time" },
    "resolution_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "resolution": {
      "type": "object",
      "required": ["path", "update_status", "no_change_rationale"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
        "update_status": { "enum": ["applied", "no_change_confirmed", "not_applicable"] },
        "no_change_rationale": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
        "expected_after_sha256": { "anyOf": [{ "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "approved_patch_digest": { "anyOf": [{ "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
