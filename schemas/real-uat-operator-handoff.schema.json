{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/real-uat-operator-handoff.schema.json",
  "title": "RealUatOperatorHandoff",
  "type": "object",
  "required": [
    "version",
    "status",
    "gate_id",
    "purpose",
    "operator_role",
    "participant_constraints",
    "preflight_checks",
    "session_steps",
    "required_outputs",
    "validation_commands",
    "stop_conditions",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["ready_for_real_operator_run"] },
    "gate_id": { "type": "string", "const": "G9" },
    "purpose": { "type": "string", "minLength": 1 },
    "operator_role": { "type": "string", "minLength": 1 },
    "participant_constraints": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "preflight_checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "description", "evidence_path", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence_path": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "session_steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "action", "expected_evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expected_evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "status_before_session", "status_after_session"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status_before_session": { "type": "string", "minLength": 1 },
          "status_after_session": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
