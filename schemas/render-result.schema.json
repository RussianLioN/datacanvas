{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/render-result.schema.json",
  "title": "RenderResult",
  "type": "object",
  "required": ["render_id", "schema_version", "source_spec_id", "outputs"],
  "additionalProperties": false,
  "properties": {
    "render_id": {
      "type": "string",
      "pattern": "^RENDER-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_spec_id": {
      "type": "string",
      "pattern": "^SPEC-[A-Za-z0-9_-]+$"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "format", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string" },
          "format": {
            "type": "string",
            "enum": ["html", "pdf", "png"]
          },
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    }
  }
}
