{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/jira-story-import-contract.schema.json",
  "title": "JiraStoryImportContract",
  "type": "object",
  "required": [
    "$schema", "version", "status", "contract_id", "source", "output", "columns",
    "field_sources", "description_template", "comment_template", "stories"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../../../schemas/jira-story-import-contract.schema.json" },
    "version": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/semver" },
    "status": { "const": "active" },
    "contract_id": { "const": "jira-story-import-2026-q4" },
    "source": {
      "type": "object",
      "required": ["scope_path", "story_catalog_path"],
      "additionalProperties": false,
      "properties": {
        "scope_path": { "const": "docs/product/sources/co-2026-003-current-2026-scope.json" },
        "story_catalog_path": { "const": "docs/product/requirements/user-stories.md" }
      }
    },
    "output": {
      "type": "object",
      "required": ["path", "encoding", "bom", "delimiter", "line_ending", "quoting"],
      "additionalProperties": false,
      "properties": {
        "path": { "const": "artifacts/generated/jira/datacanvas-stories-2026-q4.csv" },
        "encoding": { "const": "utf-8" },
        "bom": { "const": false },
        "delimiter": { "const": "," },
        "line_ending": { "const": "LF" },
        "quoting": { "const": "all" }
      }
    },
    "columns": {
      "type": "array",
      "prefixItems": [
        { "const": "Issue Type" }, { "const": "Summary" }, { "const": "Description" },
        { "const": "Priority" }, { "const": "Story ID" }, { "const": "Target quarter" },
        { "const": "Comment" }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "field_sources": {
      "type": "object",
      "required": ["issue_type_value"],
      "additionalProperties": false,
      "properties": {
        "issue_type_value": { "const": "Story" }
      }
    },
    "description_template": { "type": "string", "minLength": 1 },
    "comment_template": {
      "const": "Источник: утверждённая граница реализации 2026 года. Ресурсные данные не используются."
    },
    "stories": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "DC-ST-09" },
        { "const": "DC-ST-23" },
        { "const": "DC-ST-24" },
        { "const": "DC-ST-25" },
        { "const": "DC-ST-26" },
        { "const": "DC-ST-27" },
        { "const": "DC-ST-28" },
        { "const": "DC-ST-29" },
        { "const": "DC-ST-30" }
      ],
      "items": false
    }
  }
}
