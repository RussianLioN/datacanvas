{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/human-review-flow.schema.json",
  "title": "HumanReviewFlow",
  "type": "object",
  "required": ["version", "status", "roles", "states", "actions", "transitions", "audit_fields"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft"] },
    "roles": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "states": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "actions": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "transitions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["from", "action", "to", "allowed_roles"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "allowed_roles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "audit_fields": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
