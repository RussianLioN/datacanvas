{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/bmc-visual-acceptance.schema.json",
  "title": "BmcVisualAcceptance",
  "type": "object",
  "required": [
    "version",
    "status",
    "checked_at",
    "command",
    "exit_code",
    "canonical_visual_path",
    "input_sha256",
    "output_sha256",
    "artifact_paths",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["accepted"] },
    "checked_at": { "type": "string", "format": "date-time" },
    "command": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer", "const": 0 },
    "canonical_visual_path": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_sha256": {
      "type": "object",
      "required": ["png", "pdf", "plantuml"],
      "additionalProperties": false,
      "properties": {
        "png": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pdf": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "plantuml": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
