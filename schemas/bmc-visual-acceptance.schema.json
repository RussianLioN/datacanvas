{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/bmc-visual-acceptance.schema.json",
  "title": "BmcVisualAcceptance",
  "type": "object",
  "required": [
    "version",
    "status",
    "independent_acceptance_status",
    "evidence_kind",
    "generated_by",
    "source_trace_path",
    "source_trace_sha256",
    "source_lock_path",
    "source_lock_sha256",
    "source_revision_at",
    "source_revision_kind",
    "canonical_visual_path",
    "input_sha256",
    "output_sha256",
    "artifact_paths",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["automated_checks_passed"] },
    "independent_acceptance_status": { "type": "string", "enum": ["pending"] },
    "evidence_kind": { "type": "string", "enum": ["automated_render_checks"] },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_trace_path": { "type": "string", "const": "docs/product/bmc/bmc-trace.v0.1.json" },
    "source_trace_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_lock_path": { "type": "string", "const": "docs/product/bmc/source-lock.json" },
    "source_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_revision_at": { "type": "string", "format": "date-time" },
    "source_revision_kind": { "type": "string", "const": "declared_trace_revision" },
    "canonical_visual_path": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_sha256": {
      "type": "object",
      "required": ["png", "pdf", "plantuml"],
      "additionalProperties": false,
      "properties": {
        "png": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pdf": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "plantuml": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
