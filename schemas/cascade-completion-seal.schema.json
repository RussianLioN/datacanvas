{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-completion-seal.schema.json",
  "title": "Cascade completion seal v1",
  "type": "object",
  "required": ["$schema", "version", "seal_id", "status", "run_id", "source_run_path", "candidate_head_sha", "completed_at", "run_sha256", "acceptance_authority_sha256", "source_identity_sha256", "source_change_analysis_sha256", "semantic_impact_sha256", "resolution_report_sha256", "acceptance_set_sha256", "profile_evidence_sha256", "completion_evidence_sha256", "validation_manifest_sha256", "runtime_manifest_sha256", "actual_diff_sha256", "completion_command_set_sha256", "done_claimed"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-completion-seal.schema.json" },
    "version": { "const": "1.0.0" },
    "seal_id": { "type": "string", "pattern": "^CCS-[A-Z0-9-]+$" },
    "status": { "const": "verified" },
    "run_id": { "type": "string", "pattern": "^CUR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "source_run_path": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath" },
    "candidate_head_sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "completed_at": { "type": "string", "format": "date-time" },
    "run_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "acceptance_authority_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "source_identity_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "source_change_analysis_sha256": { "anyOf": [{ "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "semantic_impact_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "resolution_report_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "acceptance_set_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "profile_evidence_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "completion_evidence_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "validation_manifest_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "runtime_manifest_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "actual_diff_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "completion_command_set_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "done_claimed": { "const": true }
  }
}
