{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/prompt-only-artifact-link-catalog.schema.json",
  "title": "PromptOnlyArtifactLinkCatalog",
  "type": "object",
  "required": [
    "version",
    "status",
    "workflow_id",
    "scope",
    "boundary_contract",
    "chat_link_policy",
    "artifact_groups",
    "review_sequence",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "scope": {
      "type": "object",
      "required": ["repository_role", "workflow_subject", "implementation_plan_path"],
      "additionalProperties": false,
      "properties": {
        "repository_role": { "type": "string", "enum": ["documentation_repository"] },
        "workflow_subject": { "type": "string", "enum": ["project_documentation_artifact_review"] },
        "implementation_plan_path": { "$ref": "#/$defs/repoPath" }
      }
    },
    "boundary_contract": {
      "type": "object",
      "required": ["scope_statement", "prohibited_behaviors", "approval_rules", "source_of_truth_rules"],
      "additionalProperties": false,
      "properties": {
        "scope_statement": { "type": "string", "minLength": 1 },
        "prohibited_behaviors": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "approval_rules": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_of_truth_rules": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chat_link_policy": {
      "type": "object",
      "required": ["runtime_absolute_links", "persisted_paths", "open_with_default_application", "notes"],
      "additionalProperties": false,
      "properties": {
        "runtime_absolute_links": { "type": "boolean", "const": true },
        "persisted_paths": { "type": "string", "enum": ["relative_repo_paths_only"] },
        "open_with_default_application": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactGroup" }
    },
    "review_sequence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "validation": {
      "type": "object",
      "required": ["profile_command", "minimum_commands"],
      "additionalProperties": false,
      "properties": {
        "profile_command": { "type": "string", "minLength": 1 },
        "minimum_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "format": {
      "type": "string",
      "enum": ["markdown", "json", "plantuml", "svg", "png", "pdf", "script", "schema", "html", "other"]
    },
    "editPolicy": {
      "type": "string",
      "enum": ["manual_source_edit", "source_then_generate", "generated_readonly", "readonly_evidence", "review_only"]
    },
    "artifactRef": {
      "type": "object",
      "required": ["path", "format", "role", "edit_policy", "source_path", "generator_command", "validation_commands"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "format": { "$ref": "#/$defs/format" },
        "role": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "edit_policy": { "$ref": "#/$defs/editPolicy" },
        "source_path": {
          "anyOf": [
            { "$ref": "#/$defs/repoPath" },
            { "type": "null" }
          ]
        },
        "generator_command": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "validation_commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactGroup": {
      "type": "object",
      "required": [
        "group_id",
        "title",
        "group_kind",
        "source_of_truth_class",
        "edit_policy",
        "source_artifacts",
        "derived_artifacts",
        "evidence_artifacts",
        "navigation_artifacts",
        "validation_commands"
      ],
      "additionalProperties": false,
      "properties": {
        "group_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "group_kind": {
          "type": "string",
          "enum": ["process", "product_documentation", "documentation_operations"]
        },
        "source_of_truth_class": {
          "type": "string",
          "enum": ["process_source", "product_source", "architecture_source", "generated_view", "evidence"]
        },
        "edit_policy": { "$ref": "#/$defs/editPolicy" },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "derived_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "evidence_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "navigation_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "validation_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
