{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/pilot-gate-readiness.schema.json",
  "title": "PilotGateReadiness",
  "type": "object",
  "required": [
    "version",
    "status",
    "gate_id",
    "depends_on_gate_id",
    "purpose",
    "required_evidence",
    "blocking_conditions",
    "validation_commands",
    "pilot_artifacts",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["blocked_pending_external", "accepted"] },
    "gate_id": { "type": "string", "const": "G10" },
    "depends_on_gate_id": { "type": "string", "const": "G9" },
    "purpose": { "type": "string", "minLength": 1 },
    "required_evidence": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "path", "status", "required_for_gate", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["available", "pending_external", "pending_commit_or_pr"] },
          "required_for_gate": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocking_conditions": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "pilot_artifacts": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
