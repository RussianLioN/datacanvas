{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-validation-manifest.schema.json",
  "title": "Cascade validation manifest v1",
  "type": "object",
  "required": ["$schema", "version", "verification_level", "planned_commands", "manifest_sha256"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-validation-manifest.schema.json" },
    "version": { "const": "1.0.0" },
    "verification_level": { "enum": ["profile", "completion"] },
    "planned_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "gate", "mutates_files", "command_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "gate": { "enum": ["quick", "profile", "generated", "security", "full"] },
          "mutates_files": { "type": "boolean" },
          "command_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
        }
      }
    },
    "manifest_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" }
  }
}
