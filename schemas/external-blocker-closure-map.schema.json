{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/external-blocker-closure-map.schema.json",
  "title": "ExternalBlockerClosureMap",
  "type": "object",
  "required": [
    "version",
    "status",
    "source_audit_path",
    "purpose",
    "blockers",
    "validation_commands",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["ready_to_collect_external_evidence", "external_evidence_collected"] },
    "source_audit_path": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "blockers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "blocking_evidence",
          "owner_role",
          "closure_procedure",
          "supporting_artifacts",
          "validation_commands",
          "status",
          "stop_conditions"
        ],
        "additionalProperties": false,
        "properties": {
          "blocking_evidence": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "closure_procedure": { "type": "string", "minLength": 1 },
          "supporting_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "validation_commands": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "type": "string", "enum": ["pending_external", "closed"] },
          "stop_conditions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
