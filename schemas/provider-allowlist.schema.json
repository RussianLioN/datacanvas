{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/provider-allowlist.schema.json",
  "title": "ProviderAllowlist",
  "type": "object",
  "required": ["version", "status", "default_policy", "providers"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "default_policy": { "type": "string", "enum": ["deny"] },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "network_access",
          "secret_source",
          "allowed_data_classes",
          "output_contract",
          "fallback",
          "owner",
          "activation_requires"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^PROVIDER-[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["disabled", "experiment", "active"] },
          "network_access": { "type": "boolean" },
          "secret_source": { "type": "string", "enum": ["external_secret_manager_required"] },
          "allowed_data_classes": {
            "type": "array",
            "items": { "type": "string", "enum": ["public", "internal", "confidential"] }
          },
          "output_contract": { "type": "string", "enum": ["PresentationSpec"] },
          "fallback": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "activation_requires": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "accepted_proc_007",
                "accepted_adr",
                "security_review",
                "provider_specific_eval_pack",
                "cost_latency_budget",
                "trace_evidence"
              ]
            }
          }
        }
      }
    }
  }
}
