{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/business-claim-map.schema.json",
  "title": "BusinessClaimMap",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "status",
    "map_id",
    "source_registry_path",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "accepted"] },
    "map_id": { "type": "string", "pattern": "^BCLM-[A-Z0-9-]+$" },
    "source_registry_path": { "$ref": "#/$defs/repoPath" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://" },
          { "pattern": "\\\\" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "title",
        "statement",
        "precedence_source_id",
        "supporting_source_ids",
        "supersedes_claim_ids",
        "affected_artifacts",
        "expected_downstream_fragments"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "type": "string", "pattern": "^BCLM-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "precedence_source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "supporting_source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" }
        },
        "supersedes_claim_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BCLM-[A-Z0-9-]+$" }
        },
        "affected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "expected_downstream_fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_path", "fragments"],
            "additionalProperties": false,
            "properties": {
              "artifact_path": { "$ref": "#/$defs/repoPath" },
              "fragments": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
