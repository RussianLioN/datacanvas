{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/cascade-baseline-manifest.schema.json",
  "title": "Documentation cascade baseline manifest",
  "type": "object",
  "required": ["version", "baseline_id", "captured_at", "head_sha", "source_run_path", "files"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/semver"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^CBM-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_run_path": {
      "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "scope", "exists", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/repoPath"
          },
          "scope": {
            "type": "string",
            "enum": ["impact_cone", "control_input"]
          },
          "exists": {
            "type": "boolean"
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "exists": { "const": true } },
              "required": ["exists"]
            },
            "then": {
              "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
            },
            "else": {
              "properties": { "sha256": { "type": "null" } }
            }
          }
        ]
      }
    }
  }
}
