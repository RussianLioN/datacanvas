{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/interview-answer-set.schema.json",
  "title": "InterviewAnswerSet",
  "type": "object",
  "required": [
    "version",
    "status",
    "interview_id",
    "session_id",
    "data_class",
    "raw_answer_policy",
    "answers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["prepared_baseline", "completed", "draft_unvalidated"] },
    "interview_id": { "type": "string", "pattern": "^BA-SA-INT-[0-9]{4}-[0-9]{3}$" },
    "session_id": { "type": "string", "pattern": "^BA-SA-RUN-[0-9]{4}-[0-9]{3}$" },
    "data_class": { "type": "string", "enum": ["confidential"] },
    "raw_answer_policy": {
      "type": "object",
      "required": ["raw_answer_field_forbidden", "required_safe_summary", "required_claim_metadata"],
      "additionalProperties": false,
      "properties": {
        "raw_answer_field_forbidden": { "type": "boolean", "const": true },
        "required_safe_summary": { "type": "boolean", "const": true },
        "required_claim_metadata": { "type": "boolean", "const": true }
      }
    },
    "answers": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "answer_id",
          "question_id",
          "domain",
          "raw_answer_ref",
          "safe_summary",
          "data_class",
          "sensitive_flags",
          "redaction_status",
          "confirmation_status",
          "evidence_refs",
          "allowed_downstream_use"
        ],
        "additionalProperties": false,
        "properties": {
          "answer_id": { "type": "string", "pattern": "^BASA-ANS-[0-9]{3}$" },
          "question_id": { "type": "string", "pattern": "^BASA-Q[0-9]{3}$" },
          "domain": {
            "type": "string",
            "enum": [
              "stakeholders",
              "current_process",
              "target_outcome",
              "value",
              "constraints",
              "policies",
              "exceptions",
              "channels",
              "data",
              "decision_roles",
              "acceptance_examples",
              "risks",
              "metrics",
              "rollback"
            ]
          },
          "raw_answer_ref": { "type": "string", "minLength": 1 },
          "safe_summary": { "type": "string", "minLength": 1 },
          "data_class": { "type": "string", "enum": ["internal", "confidential"] },
          "sensitive_flags": {
            "type": "array",
            "items": { "type": "string", "enum": ["none", "personal_data_possible", "commercial_sensitive", "security_sensitive"] }
          },
          "redaction_status": { "type": "string", "enum": ["not_required", "redacted", "metadata_only", "blocked"] },
          "confirmation_status": { "type": "string", "enum": ["confirmed", "unconfirmed", "assumption", "contradicted"] },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_downstream_use": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["claim_extraction", "evidence_request", "hypothesis_backlog", "artifact_generation", "acceptance_gate", "none"]
            }
          }
        }
      }
    }
  }
}
