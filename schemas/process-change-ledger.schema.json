{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/process-change-ledger.schema.json",
  "title": "ProcessChangeLedger",
  "type": "object",
  "required": ["version", "status", "source_plan", "changelog_path", "entries", "known_limitations", "next_safe_step"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["active"] },
    "source_plan": { "type": "string" },
    "changelog_path": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "process_change_id",
          "title",
          "status",
          "decision",
          "source",
          "pcr_path",
          "changelog_anchor",
          "affected_artifacts",
          "validation_commands",
          "migration_notes",
          "rollback"
        ],
        "additionalProperties": false,
        "properties": {
          "process_change_id": { "type": "string", "pattern": "^PROC-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["draft", "ready", "experiment", "accepted", "rejected", "deferred"] },
          "decision": { "type": "string", "enum": ["not_decided", "reject", "defer", "experiment", "accept"] },
          "source": { "type": "string", "minLength": 1 },
          "pcr_path": { "type": "string", "minLength": 1 },
          "changelog_anchor": { "type": "string", "minLength": 1 },
          "affected_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "validation_commands": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "migration_notes": { "type": "string", "minLength": 1 },
          "rollback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
