{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/babok-research-source-index.schema.json",
  "title": "BabokResearchSourceIndex",
  "type": "object",
  "required": ["version", "status", "source_file", "source_summary", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "source_file": { "$ref": "#/$defs/repoPath" },
    "source_summary": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "section_id",
          "section_title",
          "topic",
          "applies_to",
          "rule_summary",
          "locator",
          "content_hash",
          "source_file_reference",
          "source_date_or_version"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^BABOK-SRC-\\d{3}$" },
          "section_id": { "type": "string", "minLength": 1 },
          "section_title": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "rule_summary": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "source_file_reference": { "$ref": "#/$defs/repoPath" },
          "source_date_or_version": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" },
          { "pattern": "Downloads" }
        ]
      }
    }
  }
}
