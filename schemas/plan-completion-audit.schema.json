{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/plan-completion-audit.schema.json",
  "title": "PlanCompletionAudit",
  "type": "object",
  "required": [
    "version",
    "status",
    "source_plan",
    "audit_date",
    "completion_requirements",
    "blocking_external_evidence",
    "validation_commands",
    "known_limitations",
    "next_safe_step"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["blocked_pending_external", "complete"] },
    "source_plan": { "type": "string", "minLength": 1 },
    "audit_date": { "type": "string", "format": "date" },
    "completion_requirements": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "requirement", "status", "evidence_paths", "missing_evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["met", "blocked_pending_external", "missing"] },
          "evidence_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "missing_evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "blocking_external_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_safe_step": { "type": "string", "minLength": 1 }
  }
}
