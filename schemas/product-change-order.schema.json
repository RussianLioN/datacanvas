{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/product-change-order.schema.json",
  "title": "ProductChangeOrder",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "source",
    "reason",
    "priority_before",
    "priority_after",
    "affected_users",
    "affected_artifacts",
    "affected_requirements",
    "affected_ports_adapters",
    "adr_impact",
    "sprint_impact",
    "sprint_goal_test",
    "product_owner_decision",
    "rollback",
    "validation_plan",
    "impact_assessment_path"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^CO-[0-9]{4}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "accepted", "rejected", "deferred"] },
    "source": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "priority_before": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "priority_after": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_users": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(BT|NFR)-[0-9]{3}$" } },
    "affected_ports_adapters": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "adr_impact": { "type": "string", "minLength": 1 },
    "sprint_impact": { "type": "string", "minLength": 1 },
    "sprint_goal_test": { "type": "string", "minLength": 1 },
    "product_owner_decision": {
      "type": "object",
      "required": ["decision", "decided_by_role", "decided_at", "rationale"],
      "additionalProperties": false,
      "properties": {
        "decision": { "type": "string", "enum": ["accepted", "rejected", "deferred"] },
        "decided_by_role": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "validation_plan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "impact_assessment_path": { "type": "string", "minLength": 1 }
  }
}
