{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/v1/cascade-runtime-manifest.schema.json",
  "title": "Cascade runtime manifest v1",
  "type": "object",
  "required": ["$schema", "version", "node", "npm", "python", "platform", "arch", "locale", "timezone", "lockfile_sha256", "command_map_sha256", "environment_allowlist"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://datacanvas.local/schemas/v1/cascade-runtime-manifest.schema.json" },
    "version": { "const": "1.0.0" },
    "node": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "npm": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "python": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "platform": { "type": "string", "minLength": 1 },
    "arch": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "lockfile_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "command_map_sha256": { "$ref": "https://datacanvas.local/schemas/common-defs.schema.json#/$defs/sha256" },
    "environment_allowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
  }
}
