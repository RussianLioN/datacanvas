{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/normalized-data.schema.json",
  "title": "NormalizedDataSchema",
  "type": "object",
  "required": ["normalized_id", "schema_version", "source_package_id", "data_class", "sources", "facts", "untrusted_instruction_count"],
  "additionalProperties": false,
  "properties": {
    "normalized_id": {
      "type": "string",
      "pattern": "^NORM-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_package_id": {
      "type": "string",
      "pattern": "^PKG-[A-Za-z0-9_-]+$"
    },
    "data_class": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "pii", "secret"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "trust_level"],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "trust_level": {
            "type": "string",
            "enum": ["internal", "external", "unverified"]
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "source_id", "claim", "confidence", "claim_length"],
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^FACT-[0-9]+$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[0-9]+$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "claim_length": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "untrusted_instruction_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
