{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/presentation-spec.schema.json",
  "title": "PresentationSpec",
  "type": "object",
  "required": ["spec_id", "schema_version", "source_package_id", "title", "slides"],
  "additionalProperties": false,
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_package_id": {
      "type": "string",
      "pattern": "^PKG-[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["slide_id", "title", "claims"],
        "additionalProperties": false,
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^SLIDE-[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text", "fact_ids"],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "fact_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^FACT-[0-9]+$"
                  }
                }
              }
            }
          },
          "speaker_notes": {
            "type": "string",
            "description": "Allowed only for reviewer-facing drafts; export sanitization must remove hidden notes unless explicitly approved."
          }
        }
      }
    }
  }
}

