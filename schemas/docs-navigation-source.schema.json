{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/docs-navigation-source.schema.json",
  "title": "DocsNavigationSource",
  "type": "object",
  "required": [
    "version",
    "status",
    "source_roots",
    "required_entrypoints",
    "section_rules",
    "navigation_domains",
    "navigation_groups",
    "managed_entries",
    "role_routes",
    "task_routes",
    "ignored_paths",
    "sensitive_path_rules",
    "generated_output_paths",
    "current_pointers",
    "stale_status_checks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active"] },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRoot" }
    },
    "required_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requiredEntrypoint" }
    },
    "section_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sectionRule" }
    },
    "navigation_domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/navigationDomainDefinition" }
    },
    "navigation_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/navigationGroupDefinition" }
    },
    "managed_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/managedEntry" }
    },
    "role_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "task_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskRoute" }
    },
    "ignored_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/ignoredPath" }
    },
    "sensitive_path_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/sensitivePathRule" }
    },
    "generated_output_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/generatedOutput" }
    },
    "current_pointers": {
      "type": "object",
      "required": [
        "current_sprint",
        "current_release",
        "current_process_version",
        "current_accepted_bmc",
        "current_uat_state",
        "current_main_commit",
        "current_release_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "current_sprint": { "type": "string", "minLength": 1 },
        "current_release": { "type": "string", "minLength": 1 },
        "current_process_version": { "type": "string", "minLength": 1 },
        "current_accepted_bmc": { "$ref": "#/$defs/repoPath" },
        "current_uat_state": { "type": "string", "minLength": 1 },
        "current_main_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "current_release_evidence": { "$ref": "#/$defs/repoPath" }
      }
    },
    "stale_status_checks": {
      "type": "object",
      "required": ["scan_paths", "forbidden_patterns"],
      "additionalProperties": false,
      "properties": {
        "scan_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pattern", "reason"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "pattern": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "sourceRoot": {
      "type": "object",
      "required": ["path", "formats"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["md", "json"] }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "section",
        "navigation_domain",
        "navigation_group",
        "owner_role",
        "lifecycle",
        "data_class",
        "visibility",
        "searchable",
        "navigable",
        "canonical_source",
        "generated_from",
        "redaction_status",
        "update_trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "section": { "$ref": "#/$defs/section" },
        "navigation_domain": { "$ref": "#/$defs/navigationDomain" },
        "navigation_group": { "$ref": "#/$defs/navigationGroup" },
        "owner_role": { "type": "string", "minLength": 1 },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "data_class": { "$ref": "#/$defs/dataClass" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "searchable": { "type": "boolean" },
        "navigable": { "type": "boolean" },
        "canonical_source": { "type": ["string", "null"] },
        "generated_from": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "redaction_status": { "$ref": "#/$defs/redactionStatus" },
        "update_trigger": { "type": "string", "minLength": 1 }
      }
    },
    "sectionRule": {
      "type": "object",
      "required": ["id", "path_prefix", "defaults"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path_prefix": { "$ref": "#/$defs/repoPath" },
        "defaults": { "$ref": "#/$defs/metadata" }
      }
    },
    "managedEntry": {
      "type": "object",
      "required": [
        "path",
        "route_id",
        "section",
        "navigation_domain",
        "navigation_group",
        "owner_role",
        "lifecycle",
        "data_class",
        "visibility",
        "searchable",
        "navigable",
        "canonical_source",
        "generated_from",
        "redaction_status",
        "update_trigger",
        "critical",
        "breadcrumb_required",
        "artifact_registry_required"
      ],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "route_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "section": { "$ref": "#/$defs/section" },
        "navigation_domain": { "$ref": "#/$defs/navigationDomain" },
        "navigation_group": { "$ref": "#/$defs/navigationGroup" },
        "owner_role": { "type": "string", "minLength": 1 },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "data_class": { "$ref": "#/$defs/dataClass" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "searchable": { "type": "boolean" },
        "navigable": { "type": "boolean" },
        "canonical_source": { "type": ["string", "null"] },
        "generated_from": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "redaction_status": { "$ref": "#/$defs/redactionStatus" },
        "update_trigger": { "type": "string", "minLength": 1 },
        "critical": { "type": "boolean" },
        "breadcrumb_required": { "type": "boolean" },
        "artifact_registry_required": { "type": "boolean" }
      }
    },
    "requiredEntrypoint": {
      "type": "object",
      "required": ["path", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "label", "role", "navigation_domain", "navigation_group", "start_path", "next_paths", "owner_role", "validation_command"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "navigation_domain": { "$ref": "#/$defs/navigationDomain" },
        "navigation_group": { "$ref": "#/$defs/navigationGroup" },
        "start_path": { "$ref": "#/$defs/repoPath" },
        "next_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "validation_command": { "type": "string", "minLength": 1 }
      }
    },
    "taskRoute": {
      "type": "object",
      "required": ["id", "label", "task", "navigation_domain", "navigation_group", "start_path", "next_paths", "owner_role", "validation_command"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "navigation_domain": { "$ref": "#/$defs/navigationDomain" },
        "navigation_group": { "$ref": "#/$defs/navigationGroup" },
        "start_path": { "$ref": "#/$defs/repoPath" },
        "next_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "validation_command": { "type": "string", "minLength": 1 }
      }
    },
    "ignoredPath": {
      "type": "object",
      "required": ["path", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "sensitivePathRule": {
      "type": "object",
      "required": ["id", "path_prefix", "data_class", "reason", "validation_command"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path_prefix": { "$ref": "#/$defs/repoPath" },
        "data_class": { "$ref": "#/$defs/dataClass" },
        "reason": { "type": "string", "minLength": 1 },
        "validation_command": { "type": "string", "minLength": 1 }
      }
    },
    "generatedOutput": {
      "type": "object",
      "required": ["path", "canonical_source", "description"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "canonical_source": { "$ref": "#/$defs/repoPath" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "string",
      "enum": [
        "root",
        "navigation",
        "product",
        "process",
        "architecture",
        "bmc",
        "ux-uat",
        "release-evidence",
        "sprint-artifacts",
        "security-trust",
        "generated-artifacts",
        "schemas-scripts-tests",
        "knowledge",
        "plans"
      ]
    },
    "navigationGroupDefinition": {
      "type": "object",
      "required": ["id", "navigation_domain", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/navigationGroup" },
        "navigation_domain": { "$ref": "#/$defs/navigationDomain" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "navigationDomainDefinition": {
      "type": "object",
      "required": ["id", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/navigationDomain" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "navigationDomain": {
      "type": "string",
      "enum": ["product", "documentation_operations"]
    },
    "navigationGroup": {
      "type": "string",
      "enum": ["business", "delivery", "technical", "governance", "evidence", "generated"]
    },
    "lifecycle": {
      "type": "string",
      "enum": ["active", "accepted", "draft", "in_progress", "generated", "archived", "historical"]
    },
    "dataClass": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "sensitive"]
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "internal", "restricted"]
    },
    "redactionStatus": {
      "type": "string",
      "enum": ["not_required", "redacted", "metadata_only", "blocked"]
    }
  }
}
