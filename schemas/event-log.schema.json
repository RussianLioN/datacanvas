{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/event-log.schema.json",
  "title": "WorkflowEventLog",
  "type": "object",
  "required": ["$schema", "version", "status", "run_id", "events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "archived"] },
    "run_id": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "event_id", "timestamp", "event_type", "workflow_status", "phase", "message"],
        "additionalProperties": false,
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "minLength": 1 },
          "event_type": { "type": "string", "minLength": 1 },
          "workflow_status": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
