{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/documentation-artifact-inventory.schema.json",
  "title": "DocumentationArtifactInventory",
  "type": "object",
  "required": ["$schema", "version", "status", "inventory_id", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "accepted"] },
    "inventory_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "artifact_type",
          "owner_role",
          "domain",
          "profile_scope",
          "source_of_truth_class",
          "generated",
          "data_class",
          "visibility",
          "inputs",
          "outputs",
          "validation_commands"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "artifact_type": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "enum": ["product", "documentation_operations"] },
          "profile_scope": { "type": "string", "enum": ["universal", "pilot_specific", "project_specific", "generated", "sensitive_metadata_only"] },
          "source_of_truth_class": { "type": "string", "minLength": 1 },
          "generated": { "type": "boolean" },
          "data_class": { "type": "string", "enum": ["public", "internal", "confidential", "sensitive"] },
          "visibility": { "type": "string", "enum": ["public", "internal", "restricted"] },
          "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "validation_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
