{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/user-decision-queue.schema.json",
  "title": "UserDecisionQueue",
  "type": "object",
  "required": ["version", "queue_id", "change_request_id", "status", "requested_at", "decisions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "queue_id": { "type": "string", "pattern": "^UDQ-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "change_request_id": { "type": "string", "pattern": "^DCR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["open", "blocked", "closed"] },
    "requested_at": { "type": "string", "format": "date-time" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_id",
        "question",
        "affected_artifacts",
        "options",
        "recommended_option_id",
        "recommendation_rationale",
        "status",
        "blocking",
        "requested_at",
        "resolved_at",
        "selected_option_id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string", "pattern": "^DEC-[A-Z0-9-]+$" },
        "question": { "type": "string", "minLength": 1 },
        "affected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["option_id", "label", "consequence", "recommended"],
            "additionalProperties": false,
            "properties": {
              "option_id": { "type": "string", "pattern": "^OPT-[A-Z0-9-]+$" },
              "label": { "type": "string", "minLength": 1 },
              "consequence": { "type": "string", "minLength": 1 },
              "recommended": { "type": "boolean" }
            }
          }
        },
        "recommended_option_id": { "type": ["string", "null"] },
        "recommendation_rationale": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected", "deferred", "not_applicable"] },
        "blocking": { "type": "boolean" },
        "requested_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" },
        "selected_option_id": { "type": ["string", "null"] },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
