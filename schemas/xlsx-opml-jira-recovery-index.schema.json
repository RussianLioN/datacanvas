{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacanvas.local/schemas/xlsx-opml-jira-recovery-index.schema.json",
  "title": "XlsxOpmlJiraRecoveryIndex",
  "type": "object",
  "required": ["$schema", "version", "status", "index_id", "updated_at", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "accepted"] },
    "index_id": { "type": "string", "pattern": "^XLSX-OPML-JIRA-RECOVERY-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "kind", "status", "path", "source_id", "sha256", "downstream_use", "notes"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["xlsx", "opml", "jira_import", "confluence_map"] },
          "status": { "type": "string", "enum": ["found", "not_found", "derived_reconstruction", "pending_external"] },
          "path": { "anyOf": [{ "$ref": "#/$defs/repoPath" }, { "type": "null" }] },
          "source_id": { "type": ["string", "null"], "pattern": "^SRC-[A-Z0-9-]+$" },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "downstream_use": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:/" },
          { "pattern": "\\.\\.(?:/|$)" }
        ]
      }
    }
  }
}
